import RoboLean.Geometry.TwistScrew
import RoboLean.Geometry.TwistExpClosedForm
import Mathlib.LinearAlgebra.AffineSpace.AffineSubspace.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.Tactic.NormNum

/-!
# Affine axes of twists

MLS printed pp46–49, equations (2.39) and (2.43). The affine line is an
unoriented set, while `Twist.axisDirection` retains the original directed
vector. A rotating twist uses its perpendicular axis point. Nonzero pure
translation has the conventional origin axis, but every parallel line is
also carried into itself by the same translation. Zero has no screw axis.
-/

noncomputable section

namespace RoboLean

/-- The affine line through `q` generated by `ω`; zero direction gives a singleton. -/
def axisLine (q ω : Vec3) : AffineSubspace ℝ Vec3 :=
  AffineSubspace.mk' q (Submodule.span ℝ {ω})

theorem mem_axisLine_iff (q ω x : Vec3) :
    x ∈ axisLine q ω ↔ ∃ r : ℝ, x = q + r • ω := by
  rw [axisLine, AffineSubspace.mem_mk', Submodule.mem_span_singleton]
  change (∃ r : ℝ, r • ω = x - q) ↔ _
  constructor
  · rintro ⟨r, hr⟩
    exact ⟨r, by simpa only [add_comm] using sub_eq_iff_eq_add.mp hr.symm⟩
  · rintro ⟨r, rfl⟩
    exact ⟨r, by simp⟩

@[simp] theorem axisLine_direction (q ω : Vec3) :
    (axisLine q ω).direction = Submodule.span ℝ {ω} :=
  AffineSubspace.direction_mk' _ _

theorem axisLine_finrank (q ω : Vec3) (hω : ω ≠ 0) :
    Module.finrank ℝ (axisLine q ω).direction = 1 := by
  rw [axisLine_direction]
  exact finrank_span_singleton hω

@[simp] theorem self_mem_axisLine (q ω : Vec3) : q ∈ axisLine q ω :=
  (mem_axisLine_iff q ω q).mpr ⟨0, by simp⟩

/-- Choosing another point on the same line does not change the line. -/
theorem axisLine_shift (q ω : Vec3) (r : ℝ) :
    axisLine (q + r • ω) ω = axisLine q ω := by
  have hm : q + r • ω ∈ axisLine q ω :=
    (mem_axisLine_iff q ω _).mpr ⟨r, rfl⟩
  simpa only [axisLine, AffineSubspace.direction_mk'] using AffineSubspace.mk'_eq hm

/-- The underlying line is unchanged by nonzero direction scaling, including negative scaling. -/
theorem axisLine_smul_direction (q ω : Vec3) (c : ℝ) (hc : c ≠ 0) :
    axisLine q (c • ω) = axisLine q ω := by
  ext x
  rw [mem_axisLine_iff, mem_axisLine_iff]
  constructor
  · rintro ⟨r, rfl⟩
    exact ⟨r * c, by rw [smul_smul]⟩
  · rintro ⟨r, rfl⟩
    refine ⟨r / c, ?_⟩
    rw [smul_smul, div_mul_cancel₀ r hc]

theorem axisLine_eq_iff_mem (q q' ω : Vec3) :
    axisLine q' ω = axisLine q ω ↔ q' ∈ axisLine q ω := by
  constructor
  · intro h
    rw [← h]
    exact self_mem_axisLine _ _
  · intro h
    obtain ⟨r, rfl⟩ := (mem_axisLine_iff q ω q').mp h
    exact axisLine_shift q ω r

/-- A nonzero translation direction admits distinct parallel axes in three-space. -/
theorem exists_distinct_parallel_axis (v : Vec3) (hv : v ≠ 0) :
    ∃ q : Vec3, axisLine q v ≠ axisLine 0 v := by
  classical
  have htop : Submodule.span ℝ {v} ≠ ⊤ := by
    intro heq
    have hd : Module.finrank ℝ (Submodule.span ℝ {v}) = 1 := finrank_span_singleton hv
    rw [heq, finrank_top, show Module.finrank ℝ Vec3 = 3 from finrank_euclideanSpace_fin] at hd
    norm_num at hd
  have hex : ∃ q : Vec3, q ∉ Submodule.span ℝ {v} := by
    by_contra! h
    apply htop
    ext x
    simp only [Submodule.mem_top, iff_true]
    exact h x
  obtain ⟨q, hq⟩ := hex
  refine ⟨q, ?_⟩
  intro heq
  have hm := (axisLine_eq_iff_mem 0 q v).mp heq
  rw [axisLine, AffineSubspace.mem_mk'] at hm
  exact hq (by simpa using hm)

namespace RigidTransform

/-- Rigid point action sends an affine line to the line with transformed point and direction. -/
theorem image_axisLine (g : RigidTransform) (q ω : Vec3) :
    g.applyPoint '' (axisLine q ω : Set Vec3) =
      (axisLine (g.applyPoint q) (g.applyVector ω) : Set Vec3) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨r, rfl⟩ := (mem_axisLine_iff q ω y).mp hy
    apply (mem_axisLine_iff _ _ _).mpr
    refine ⟨r, ?_⟩
    simp [applyPoint_add, applyVector]
  · intro hx
    obtain ⟨r, hr⟩ := (mem_axisLine_iff _ _ x).mp hx
    refine ⟨q + r • ω, (mem_axisLine_iff q ω _).mpr ⟨r, rfl⟩, ?_⟩
    simpa [applyPoint_add, applyVector] using hr.symm

end RigidTransform
namespace Twist

/-- The finite affine axis, requiring a nonzero angular component. -/
def finiteAxis (ξ : Twist) (hω : ξ.angular ≠ 0) : AffineSubspace ℝ Vec3 :=
  axisLine (axisPoint ξ hω) ξ.angular

theorem mem_finiteAxis_iff (ξ : Twist) (hω : ξ.angular ≠ 0) (x : Vec3) :
    x ∈ finiteAxis ξ hω ↔ ∃ r : ℝ, x = axisPoint ξ hω + r • ξ.angular :=
  mem_axisLine_iff _ _ _

@[simp] theorem finiteAxis_direction (ξ : Twist) (hω : ξ.angular ≠ 0) :
    (finiteAxis ξ hω).direction = Submodule.span ℝ {ξ.angular} :=
  axisLine_direction _ _

theorem finiteAxis_finrank (ξ : Twist) (hω : ξ.angular ≠ 0) :
    Module.finrank ℝ (finiteAxis ξ hω).direction = 1 :=
  axisLine_finrank _ _ hω

theorem finiteAxis_smul (ξ : Twist) (hω : ξ.angular ≠ 0) (c : ℝ) (hc : c ≠ 0) :
    finiteAxis (c • ξ) (angular_smul_ne_zero ξ hω c hc) = finiteAxis ξ hω := by
  change axisLine (axisPoint (c • ξ) _) (c • ξ.angular) = axisLine (axisPoint ξ hω) ξ.angular
  rw [axisPoint_smul ξ hω c hc, axisLine_smul_direction _ _ c hc]

/-- The source convention chooses the origin axis for nonzero pure translation. -/
def pureTranslationAxis (v : Vec3) (_hv : v ≠ 0) : AffineSubspace ℝ Vec3 :=
  axisLine 0 v

theorem mem_pureTranslationAxis_iff (v : Vec3) (hv : v ≠ 0) (x : Vec3) :
    x ∈ pureTranslationAxis v hv ↔ ∃ r : ℝ, x = r • v := by
  simpa only [pureTranslationAxis, zero_add] using mem_axisLine_iff 0 v x

theorem pureTranslationAxis_finrank (v : Vec3) (hv : v ≠ 0) :
    Module.finrank ℝ (pureTranslationAxis v hv).direction = 1 :=
  axisLine_finrank 0 v hv

/-- The actual translation carries every parallel axis into itself, independently of its point. -/
theorem pure_translation_axis_motion (v q : Vec3) (t r : ℝ) :
    (exp ⟨v, 0⟩ t).applyPoint (q + r • v) = q + (r + t) • v := by
  rw [exp_pure_translation]
  simp [RigidTransform.applyPoint, Rotation.act_one, add_smul, add_assoc]

/-- Directed coordinates; zero returns the zero vector, and has no axis in `screwAxis`. -/
def axisDirection (ξ : Twist) : Vec3 := by
  classical
  exact if ξ.angular = 0 then ξ.linear else ξ.angular

theorem norm_axisDirection (ξ : Twist) : ‖axisDirection ξ‖ = screwMagnitude ξ := by
  classical
  by_cases hω : ξ.angular = 0 <;> simp [axisDirection, screwMagnitude, hω]

theorem axisDirection_ne_zero (ξ : Twist) (hξ : ξ ≠ 0) : axisDirection ξ ≠ 0 := by
  intro h
  have hm : screwMagnitude ξ = 0 := by rw [← norm_axisDirection, h, norm_zero]
  exact hξ ((screwMagnitude_eq_zero_iff ξ).mp hm)

/-- A rotating finite axis, an origin translation axis, or no axis for zero. -/
def screwAxis (ξ : Twist) : Option (AffineSubspace ℝ Vec3) := by
  classical
  exact if hω : ξ.angular = 0 then
    if hv : ξ.linear = 0 then none else some (pureTranslationAxis ξ.linear hv)
  else some (finiteAxis ξ hω)

@[simp] theorem screwAxis_of_angular_ne_zero (ξ : Twist) (hω : ξ.angular ≠ 0) :
    screwAxis ξ = some (finiteAxis ξ hω) := by
  simp [screwAxis, hω]

@[simp] theorem screwAxis_pure_translation (v : Vec3) (hv : v ≠ 0) :
    screwAxis ⟨v, 0⟩ = some (pureTranslationAxis v hv) := by
  simp [screwAxis, hv]

@[simp] theorem screwAxis_zero : screwAxis (0 : Twist) = none := by
  simp [screwAxis]

theorem screwAxis_eq_none_iff (ξ : Twist) : screwAxis ξ = none ↔ ξ = 0 := by
  classical
  rcases ξ with ⟨v, ω⟩
  by_cases hω : ω = 0 <;> by_cases hv : v = 0 <;>
    simp [screwAxis, hω, hv]

/-- All parallel affine axes compatible with a nonzero pure translation. -/
def translationAxes (v : Vec3) (_hv : v ≠ 0) : Set (AffineSubspace ℝ Vec3) :=
  Set.range (fun q : Vec3 ↦ axisLine q v)

theorem mem_translationAxes_iff (v : Vec3) (hv : v ≠ 0) (L : AffineSubspace ℝ Vec3) :
    L ∈ translationAxes v hv ↔ ∃ q : Vec3, axisLine q v = L := Iff.rfl

theorem pureTranslationAxis_mem_family (v : Vec3) (hv : v ≠ 0) :
    pureTranslationAxis v hv ∈ translationAxes v hv := ⟨0, rfl⟩

theorem translationAxes_finrank (v : Vec3) (hv : v ≠ 0) (L : AffineSubspace ℝ Vec3)
    (hL : L ∈ translationAxes v hv) : Module.finrank ℝ L.direction = 1 := by
  obtain ⟨q, rfl⟩ := hL
  exact axisLine_finrank q v hv

/-- The family has at least two distinct lines, although the origin representative is fixed. -/
theorem translationAxes_nonunique (v : Vec3) (hv : v ≠ 0) :
    ∃ L M : AffineSubspace ℝ Vec3,
      L ∈ translationAxes v hv ∧ M ∈ translationAxes v hv ∧ L ≠ M := by
  obtain ⟨q, hq⟩ := exists_distinct_parallel_axis v hv
  exact ⟨axisLine q v, axisLine 0 v, ⟨q, rfl⟩, ⟨0, rfl⟩, hq⟩

end Twist
end RoboLean
