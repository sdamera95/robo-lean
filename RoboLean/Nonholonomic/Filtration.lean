import RoboLean.Nonholonomic.Distribution
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# The filtration of a distribution, growth vectors and the controllability Lie algebra

MLS Chapter 7: the Lie algebra `L(g₁, …, g_m)` generated by the input fields and its rank at a
point (Definition 7.1, printed p. 326; the controllability Lie algebra, p. 329), the filtration
`Δ₁ = Δ`, `Δᵢ = Δᵢ₋₁ + [Δ₁, Δᵢ₋₁]` (p. 340), its regularity, the degree of nonholonomy
(Definition 7.2, p. 340) and the growth and relative growth vectors (Definition 7.3, p. 341).

**Conventions.** The generators are `g : Fin m → E → E`. `filtrationFields g i` is the set of
fields spanning `Δᵢ`: none for `i = 0`, and for `i + 1` the generators together with the brackets
`[gⱼ, w]` of a generator with a field `w` spanning `Δᵢ` (MLS p. 340: "`Δᵢ` is defined to be
spanned by the input vector fields plus the vector fields formed by taking up to `i − 1` Lie
brackets of the generators", with `[Δ₁, Δᵢ₋₁]` spanned by brackets `[g, h]`, `g ∈ Δ₁`,
`h ∈ Δᵢ₋₁`). `filtrationAt g i q` is `Δᵢ(q)`, `growth g i q = rank Δᵢ(q)` (so `r₀ = 0`, p. 341).
The book's span over smooth functions and the real span used here have the same values at each
point (`lieBracket_sum_smul_sum_smul`). The Lie algebra `L(g)` is the smallest set of fields
containing the generators and closed under real linear combinations and brackets
(`InLieAlgebra`), "obtained by taking all linear combinations of elements of `g₁, …, g_m`, taking
Lie brackets of these, taking all linear combinations of these, and so on" (p. 326); its rank at
`q` is the dimension of `lieAlgebraAt g q`. Every `Δᵢ(q)` lies in it; the reverse inclusion (Jacobi
reduction to left-normed brackets) is `Nonholonomic/ChowJacobi`.
-/

noncomputable section

open Set Filter Topology VectorField

namespace RoboLean
namespace Nonholonomic

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {m : ℕ}

/-- **MLS p. 340: the fields spanning the filtration `Δᵢ`.** `Δ₀` has none; `Δᵢ₊₁` is spanned by
the generators and the brackets `[gⱼ, w]` with `w` spanning `Δᵢ`. -/
def filtrationFields (g : Fin m → E → E) : ℕ → Set (E → E)
  | 0 => ∅
  | i + 1 => Set.range g ∪ {f | ∃ j, ∃ w ∈ filtrationFields g i, f = lieBracket ℝ (g j) w}

/-- **MLS p. 340: `Δᵢ(q)`,** the span of the values at `q` of the fields spanning `Δᵢ`. -/
def filtrationAt (g : Fin m → E → E) (i : ℕ) (q : E) : Submodule ℝ E :=
  spanAt (filtrationFields g i) q

/-- **MLS p. 340: `Δ₁ = Δ`:** the first level is spanned by the generators. -/
theorem filtrationFields_one (g : Fin m → E → E) : filtrationFields g 1 = Set.range g := by
  ext f
  simp [filtrationFields]

/-- **MLS p. 340: `Δᵢ ⊂ Δᵢ₊₁`,** for the spanning fields. -/
theorem filtrationFields_mono (g : Fin m → E → E) {i j : ℕ} (h : i ≤ j) :
    filtrationFields g i ⊆ filtrationFields g j := by
  have step : ∀ i, filtrationFields g i ⊆ filtrationFields g (i + 1) := by
    intro i
    induction i with
    | zero => exact Set.empty_subset _
    | succ i ih =>
      rintro f (hf | ⟨j, w, hw, rfl⟩)
      · exact Or.inl hf
      · exact Or.inr ⟨j, w, ih hw, rfl⟩
  exact monotone_nat_of_le_succ step h

/-- **MLS p. 340: `[Δ₁, Δᵢ] ⊂ Δᵢ₊₁`** for the spanning fields: `[gⱼ, w]` spans `Δᵢ₊₁` when `w`
spans `Δᵢ`. -/
theorem lieBracket_mem_filtrationFields (g : Fin m → E → E) {i : ℕ} (j : Fin m) {w : E → E}
    (hw : w ∈ filtrationFields g i) : lieBracket ℝ (g j) w ∈ filtrationFields g (i + 1) := by
  exact Or.inr ⟨j, w, hw, rfl⟩

/-- **MLS p. 341: `r₀ := 0`:** the zeroth level is the zero subspace. -/
theorem filtrationAt_zero (g : Fin m → E → E) (q : E) : filtrationAt g 0 q = ⊥ := by
  simp [filtrationAt, spanAt, filtrationFields]

/-- **MLS p. 340: `Δ₁(q) = Δ_q`.** -/
theorem filtrationAt_one (g : Fin m → E → E) (q : E) :
    filtrationAt g 1 q = spanAt (Set.range g) q := by
  rw [filtrationAt, filtrationFields_one]

/-- **MLS p. 340: `Δᵢ(q) ⊂ Δⱼ(q)` for `i ≤ j`.** -/
theorem filtrationAt_mono (g : Fin m → E → E) {i j : ℕ} (h : i ≤ j) (q : E) :
    filtrationAt g i q ≤ filtrationAt g j q := by
  exact spanAt_mono (filtrationFields_mono g h) q

/-- **MLS p. 340 for two inputs: `Δ₂(q) = span{g₁(q), g₂(q), [g₁, g₂](q)}`.** -/
theorem filtrationAt_two (g : Fin 2 → E → E) (q : E) :
    filtrationAt g 2 q = Submodule.span ℝ {g 0 q, g 1 q, lieBracket ℝ (g 0) (g 1) q} := by
  have h1 : ∀ k, g k ∈ filtrationFields g 1 := fun k => by
    rw [filtrationFields_one]
    exact Set.mem_range_self k
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨f, hf, rfl⟩
    change f ∈ Set.range g ∪
      {f | ∃ j, ∃ w ∈ filtrationFields g 1, f = lieBracket ℝ (g j) w} at hf
    rcases hf with ⟨j, rfl⟩ | ⟨j, w, hw, rfl⟩
    · fin_cases j
      · exact Submodule.subset_span (by simp)
      · exact Submodule.subset_span (by simp)
    · rw [filtrationFields_one] at hw
      obtain ⟨k, rfl⟩ := hw
      fin_cases j <;> fin_cases k
      · show lieBracket ℝ (g 0) (g 0) q ∈ _
        rw [lieBracket_self]
        exact zero_mem _
      · show lieBracket ℝ (g 0) (g 1) q ∈ _
        exact Submodule.subset_span (by simp)
      · show lieBracket ℝ (g 1) (g 0) q ∈ _
        rw [SetLike.mem_coe, lieBracket_swap (V := g 1)]
        exact Submodule.neg_mem _ (Submodule.subset_span (by simp))
      · show lieBracket ℝ (g 1) (g 1) q ∈ _
        rw [lieBracket_self]
        exact zero_mem _
  · refine Submodule.span_le.mpr ?_
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe]
    refine ⟨mem_spanAt (Or.inl (Set.mem_range_self 0)) q,
      mem_spanAt (Or.inl (Set.mem_range_self 1)) q,
      mem_spanAt (lieBracket_mem_filtrationFields g 0 (h1 1)) q⟩

/-- **MLS Definition 7.3, p. 341: the growth `rᵢ = rank Δᵢ(q)`** at the point `q`. -/
def growth (g : Fin m → E → E) (i : ℕ) (q : E) : ℕ := Module.finrank ℝ (filtrationAt g i q)

/-- **MLS Definition 7.3, p. 341: `r₀ := 0`.** -/
theorem growth_zero (g : Fin m → E → E) (q : E) : growth g 0 q = 0 := by
  rw [growth, filtrationAt_zero, finrank_bot]

/-- **MLS p. 340: the ranks increase along the filtration** (finite-dimensional `E`). -/
theorem growth_mono [FiniteDimensional ℝ E] (g : Fin m → E → E) {i j : ℕ} (h : i ≤ j) (q : E) :
    growth g i q ≤ growth g j q := by
  exact Submodule.finrank_mono (filtrationAt_mono g h q)

/-- **MLS p. 340: "`rank Δᵢ ≤ n`".** -/
theorem growth_le_finrank [FiniteDimensional ℝ E] (g : Fin m → E → E) (i : ℕ) (q : E) :
    growth g i q ≤ Module.finrank ℝ E := by
  exact Submodule.finrank_le _

/-- **MLS Definition 7.3, p. 341: the growth vector `r ∈ ℤ^κ`, `rᵢ = rank Δᵢ`,** indexed
`0, …, κ − 1` for `r₁, …, r_κ`. -/
def growthVector (g : Fin m → E → E) (κ : ℕ) (q : E) : Fin κ → ℕ := fun i => growth g (i + 1) q

/-- **MLS Definition 7.3, p. 341: the relative growth vector `σᵢ = rᵢ − rᵢ₋₁`, `r₀ := 0`,**
indexed `0, …, κ − 1` for `σ₁, …, σ_κ`. -/
def relativeGrowthVector (g : Fin m → E → E) (κ : ℕ) (q : E) : Fin κ → ℤ :=
  fun i => (growth g (i + 1) q : ℤ) - growth g i q

/-- **MLS p. 340: a filtration regular in a neighborhood `U` of `q₀`,**
`rank Δᵢ(q) = rank Δᵢ(q₀)` for every `i` and every `q ∈ U`. -/
def IsRegularFiltrationOn (g : Fin m → E → E) (U : Set E) (q₀ : E) : Prop :=
  ∀ i, ∀ q ∈ U, growth g i q = growth g i q₀

/-- **MLS Definition 7.2, p. 340: `κ` is the degree of nonholonomy at `q`,** the smallest integer
`κ ≥ 1` with `rank Δ_κ(q) = rank Δ_{κ+1}(q)`: the rank grows strictly at every earlier step. MLS
asks the filtration to be regular; regularity is a separate hypothesis
(`IsRegularFiltrationOn`). -/
def IsDegreeOfNonholonomy (g : Fin m → E → E) (q : E) (κ : ℕ) : Prop :=
  1 ≤ κ ∧ growth g κ q = growth g (κ + 1) q ∧ ∀ i, 1 ≤ i → i < κ → growth g i q < growth g (i + 1) q

/-- **MLS Definition 7.2, p. 340: the degree of nonholonomy is unique** ("the smallest integer"). -/
theorem IsDegreeOfNonholonomy.unique {g : Fin m → E → E} {q : E} {κ κ' : ℕ}
    (h : IsDegreeOfNonholonomy g q κ) (h' : IsDegreeOfNonholonomy g q κ') : κ = κ' := by
  obtain ⟨h1, h2, h3⟩ := h
  obtain ⟨h1', h2', h3'⟩ := h'
  rcases lt_trichotomy κ κ' with hlt | heq | hgt
  · exact absurd h2 (h3' κ h1 hlt).ne
  · exact heq
  · exact absurd h2' (h3 κ' h1' hgt).ne

/-- **MLS Definition 7.1 and p. 326: the Lie algebra `L(g₁, …, g_m)` generated by the fields,**
the smallest set of fields containing the generators and closed under sums, real multiples and
brackets. -/
inductive InLieAlgebra (g : Fin m → E → E) : (E → E) → Prop
  /-- The generators. -/
  | gen (j : Fin m) : InLieAlgebra g (g j)
  /-- Sums. -/
  | add {f h : E → E} : InLieAlgebra g f → InLieAlgebra g h → InLieAlgebra g (f + h)
  /-- Real multiples. -/
  | smul (c : ℝ) {f : E → E} : InLieAlgebra g f → InLieAlgebra g (c • f)
  /-- Brackets. -/
  | bracket {f h : E → E} : InLieAlgebra g f → InLieAlgebra g h →
      InLieAlgebra g (lieBracket ℝ f h)

/-- **MLS p. 326: the values of `L(g₁, …, g_m)` at `q`;** its dimension is the rank of the
controllability Lie algebra at `q` (p. 329). -/
def lieAlgebraAt (g : Fin m → E → E) (q : E) : Submodule ℝ E :=
  spanAt {f | InLieAlgebra g f} q

/-- **MLS pp. 326 and 340:** every field spanning a level of the filtration lies in
`L(g₁, …, g_m)`. -/
theorem filtrationFields_subset_lieAlgebra (g : Fin m → E → E) (i : ℕ) :
    filtrationFields g i ⊆ {f | InLieAlgebra g f} := by
  induction i with
  | zero => exact Set.empty_subset _
  | succ i ih =>
    rintro f (⟨j, rfl⟩ | ⟨j, w, hw, rfl⟩)
    · exact InLieAlgebra.gen j
    · exact InLieAlgebra.bracket (InLieAlgebra.gen j) (ih hw)

/-- **MLS pp. 326 and 340:** `Δᵢ(q)` lies in the values of `L(g₁, …, g_m)` at `q`. -/
theorem filtrationAt_le_lieAlgebraAt (g : Fin m → E → E) (i : ℕ) (q : E) :
    filtrationAt g i q ≤ lieAlgebraAt g q := by
  exact spanAt_mono (filtrationFields_subset_lieAlgebra g i) q

/-- **MLS p. 341: a full-rank level gives the controllability rank condition** of Theorem 7.5
(p. 329): if `Δᵢ(q) = T_q E` then `L(g₁, …, g_m)` has full rank at `q`. -/
theorem lieAlgebraAt_eq_top_of_filtrationAt (g : Fin m → E → E) {i : ℕ} {q : E}
    (h : filtrationAt g i q = ⊤) : lieAlgebraAt g q = ⊤ := by
  rw [eq_top_iff, ← h]
  exact filtrationAt_le_lieAlgebraAt g i q

/-- **MLS pp. 340–341, a full-rank test:** if `n = dim E` linearly independent vectors lie in
`Δᵢ(q)`, then `Δᵢ(q) = T_q E`. -/
theorem filtrationAt_eq_top_of_linearIndependent [FiniteDimensional ℝ E] (g : Fin m → E → E)
    {i : ℕ} {q : E} {n : ℕ} (hn : Module.finrank ℝ E = n) {v : Fin n → E}
    (hv : LinearIndependent ℝ v) (hmem : ∀ k, v k ∈ filtrationAt g i q) :
    filtrationAt g i q = ⊤ := by
  have hle : Submodule.span ℝ (Set.range v) ≤ filtrationAt g i q :=
    Submodule.span_le.mpr (Set.range_subset_iff.mpr hmem)
  have hspan : Module.finrank ℝ (Submodule.span ℝ (Set.range v)) = n := by
    rw [finrank_span_eq_card hv, Fintype.card_fin]
  refine Submodule.eq_top_of_finrank_eq (le_antisymm (Submodule.finrank_le _) ?_)
  rw [hn, ← hspan]
  exact Submodule.finrank_mono hle

end Nonholonomic
end RoboLean
