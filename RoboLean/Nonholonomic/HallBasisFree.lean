import RoboLean.Nonholonomic.HallBasis
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.Algebra.FreeMonoid.Basic

/-!
# Example 7.12 in the free Lie algebra: the fourteen Hall products are independent (MLS p. 345)

**What MLS prints.** "A basis for the nilpotent Lie algebra of order 3 generated by `g₁, g₂, g₃`"
is the list of fourteen products of Example 7.12 (p. 345).

**Proved here (independence half).** The fourteen Hall products of length at most 3 in three
generators are linearly independent in Mathlib's free Lie algebra `FreeLieAlgebra ℝ (Fin 3)`
(`linearIndependent_hallFourteen`). The proof maps the free Lie algebra by its universal property
into the free associative algebra `ℝ[FreeMonoid (Fin 3)]` with the commutator bracket, where each
Hall product is a noncommutative polynomial with a word of its own (`x₁x₁x₂` for `[g₁, [g₁, g₂]]`,
…), and reads off coefficients. With the spanning half of `HallBasis` (every Lie algebra nilpotent
of order 3 is spanned by the fourteen), this is Example 7.12 except that the free nilpotent Lie
algebra of order 3, a quotient of the free Lie algebra, is not constructed here.

**Conventions.** Generators `0, 1, 2` for `g₁, g₂, g₃`; the products are listed in the book's order
with `[g₁, g₃]` for the printed `[g₃, g₁]` (corrected printing, as in `PhilipHall`).
-/

noncomputable section

open RoboLean.Nonholonomic.LieProduct

namespace RoboLean
namespace Nonholonomic
namespace LieProduct

attribute [local instance 100] LieRing.ofAssociativeRing

/-- **MLS Example 7.12, p. 345: the fourteen Hall products** `g₁, g₂, g₃`, `[g₁, g₂]`, `[g₁, g₃]`,
`[g₂, g₃]` and the eight products of length 3, in the printed order. -/
def hallFourteen : Fin 14 → LieProduct 3 :=
  ![gen 0, gen 1, gen 2, br (gen 0) (gen 1), br (gen 0) (gen 2), br (gen 1) (gen 2),
    br (gen 0) (br (gen 0) (gen 1)), br (gen 0) (br (gen 0) (gen 2)),
    br (gen 1) (br (gen 0) (gen 1)), br (gen 1) (br (gen 0) (gen 2)),
    br (gen 1) (br (gen 1) (gen 2)), br (gen 2) (br (gen 0) (gen 1)),
    br (gen 2) (br (gen 0) (gen 2)), br (gen 2) (br (gen 1) (gen 2))]

/-- **MLS Example 7.12, p. 345:** the fourteen listed products are exactly the Hall products of
length at most 3 (the two lists are permutations of each other). -/
theorem hallUpToThree_perm_hallFourteen : hallUpToThree.Perm (List.ofFn hallFourteen) := by
  decide

/-- The generator `xᵢ` of the free associative algebra `ℝ[FreeMonoid (Fin 3)]` (supporting
definition for MLS p. 345). -/
def freeAssocGen (i : Fin 3) : MonoidAlgebra ℝ (FreeMonoid (Fin 3)) :=
  MonoidAlgebra.single (FreeMonoid.of i) 1

private theorem word_eq_iff (a b : FreeMonoid (Fin 3)) : a = b ↔ a.toList = b.toList :=
  FreeMonoid.toList.injective.eq_iff.symm

/-- **For MLS Example 7.12, p. 345:** the fourteen Hall products, evaluated at the generators of
the free associative algebra with the commutator bracket, are linearly independent. -/
theorem linearIndependent_hallFourteen_freeAssoc :
    LinearIndependent ℝ fun i => evalIn freeAssocGen (hallFourteen i) := by
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  have key : ∀ w : List (Fin 3),
      (∑ i, c i • evalIn freeAssocGen (hallFourteen i)).coeff (FreeMonoid.ofList w) = 0 := by
    intro w; rw [hc]; rfl
  fin_cases i
  · have h := key [0]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [1]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [2]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [0, 1]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [0, 2]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [1, 2]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [0, 0, 1]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [0, 0, 2]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [0, 1, 1]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [0, 2, 1]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [1, 1, 2]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [0, 1, 2]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [0, 2, 2]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h
  · have h := key [1, 2, 2]
    simp [Fin.sum_univ_succ, hallFourteen, evalIn, freeAssocGen, Ring.lie_def,
      MonoidAlgebra.single_mul_single, sub_mul, mul_sub, word_eq_iff, FreeMonoid.toList_mul,
      FreeMonoid.toList_of, mul_assoc] at h
    simpa using h

/-- A Lie algebra morphism carries the value of a Lie product to the value at the images
(supporting lemma for MLS p. 345). -/
theorem map_evalIn {R L L' : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] [LieRing L']
    [LieAlgebra R L'] (φ : L →ₗ⁅R⁆ L') {m : ℕ} (x : Fin m → L) (A : LieProduct m) :
    φ (evalIn x A) = evalIn (fun i => φ (x i)) A := by
  induction A with
  | gen i => rfl
  | br a b iha ihb => simp only [evalIn, LieHom.map_lie, iha, ihb]

/-- **MLS Example 7.12, p. 345, independence half:** the fourteen Hall products of length at most
3 are linearly independent in the free Lie algebra on three generators over `ℝ`. -/
theorem linearIndependent_hallFourteen :
    LinearIndependent ℝ fun i => evalIn (FreeLieAlgebra.of ℝ (X := Fin 3)) (hallFourteen i) := by
  set φ := FreeLieAlgebra.lift ℝ freeAssocGen
  apply LinearIndependent.of_comp φ.toLinearMap
  have h : (φ.toLinearMap ∘ fun i =>
      evalIn (FreeLieAlgebra.of ℝ (X := Fin 3)) (hallFourteen i)) =
      fun i => evalIn freeAssocGen (hallFourteen i) := by
    funext i
    simp only [Function.comp_apply, LieHom.coe_toLinearMap]
    rw [map_evalIn]
    congr 1
    funext j
    exact FreeLieAlgebra.lift_of_apply freeAssocGen j
  rw [h]
  exact linearIndependent_hallFourteen_freeAssoc

end LieProduct
end Nonholonomic
end RoboLean
