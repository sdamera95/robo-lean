import RoboLean.Nonholonomic.Filtration
import Mathlib.Algebra.Lie.Subalgebra

/-!
# The Lie algebra of smooth vector fields (MLS Definition 7.1, p. 326)

**What MLS prints.** "A vector space `V` (over `ℝ`) is a Lie algebra if there exists a bilinear
operation `V × V → V`, denoted `[ , ]`, satisfying (i) skew-symmetry and (ii) the Jacobi identity.
The set of smooth vector fields on `ℝⁿ` with the Lie bracket is a Lie algebra, and is denoted
`X(ℝⁿ)`. … Then, `Δ̄` is a Lie algebra (in fact the smallest Lie algebra containing
`g₁, …, g_m`). It is called the Lie algebra generated by `g₁, …, g_m`" (p. 326).

**Formalized here.** The smooth (`C^∞`) vector fields on a real normed space `E` form a submodule
`smoothFields E` of `E → E`; with Mathlib's bracket `VectorField.lieBracket` (the book's sign,
p. 324) it is a Lie ring and a real Lie algebra (`LieRing`, `LieAlgebra ℝ`): bilinearity from the
product rule, skew-symmetry, and the Jacobi identity in Mathlib's Leibniz form
`[U, [V, W]] = [[U, V], W] + [V, [U, W]]`. For smooth generators the library's `L(g₁, …, g_m)`
(`InLieAlgebra`) is exactly Mathlib's Lie subalgebra generated by them (`LieSubalgebra.lieSpan`),
the smallest Lie subalgebra of `X(E)` containing them.
-/

noncomputable section

open VectorField
open scoped ContDiff

namespace RoboLean
namespace Nonholonomic

variable (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- **MLS Definition 7.1, p. 326: the smooth vector fields `X(E)`,** the `C^∞` maps `E → E`, a
real vector space (a submodule of all maps `E → E`). -/
def smoothFields : Submodule ℝ (E → E) where
  carrier := {f | ContDiff ℝ ∞ f}
  add_mem' {f g} (hf : ContDiff ℝ ∞ f) (hg : ContDiff ℝ ∞ g) := hf.add hg
  zero_mem' := (contDiff_const : ContDiff ℝ ∞ fun _ : E => (0 : E))
  smul_mem' c f (hf : ContDiff ℝ ∞ f) := (contDiff_const (c := c)).smul hf

variable {E}

/-- **MLS Definition 7.1, p. 326:** membership in `X(E)` is smoothness. -/
theorem mem_smoothFields {f : E → E} : f ∈ smoothFields E ↔ ContDiff ℝ ∞ f := Iff.rfl

/-- **MLS p. 324 and Definition 7.1, p. 326: the bracket of two smooth fields is smooth**
(Mathlib's bracket, the book's sign `[f, g] = Dg f − Df g`). -/
theorem lieBracket_mem_smoothFields {f g : E → E} (hf : f ∈ smoothFields E)
    (hg : g ∈ smoothFields E) : lieBracket ℝ f g ∈ smoothFields E :=
  ContDiff.lieBracket_vectorField (m := ∞) (n := ∞) (mem_smoothFields.1 hf)
    (mem_smoothFields.1 hg) (by simp)

/-- **MLS Definition 7.1, p. 326: the bracket on `X(E)`,** Mathlib's `lieBracket` (the book's
sign). -/
instance : Bracket (smoothFields E) (smoothFields E) where
  bracket f g := ⟨lieBracket ℝ f g, lieBracket_mem_smoothFields f.2 g.2⟩

/-- **MLS Definition 7.1, p. 326:** the bracket on `X(E)` is the bracket of the underlying
fields. -/
theorem coe_lie (f g : smoothFields E) : ((⁅f, g⁆ : smoothFields E) : E → E) =
    lieBracket ℝ (f : E → E) (g : E → E) := rfl

/-- **MLS Definition 7.1, p. 326: `X(E)` with the Lie bracket is a Lie ring:** the bracket is
additive in each argument, `[f, f] = 0` (skew-symmetry, Proposition 7.1(1)) and the Jacobi
identity holds in the Leibniz form (Proposition 7.1(2)). -/
instance : LieRing (smoothFields E) where
  add_lie f g h := by
    apply Subtype.ext; funext x
    exact lieBracket_add_left ((mem_smoothFields.1 f.2).differentiable (by simp) x) ((mem_smoothFields.1 g.2).differentiable (by simp) x)
  lie_add f g h := by
    apply Subtype.ext; funext x
    exact lieBracket_add_right ((mem_smoothFields.1 g.2).differentiable (by simp) x) ((mem_smoothFields.1 h.2).differentiable (by simp) x)
  lie_self f := by
    apply Subtype.ext; funext x
    have h := lieBracket_swap (𝕜 := ℝ) (V := (f : E → E)) (W := (f : E → E)) (x := x)
    change lieBracket ℝ (f : E → E) f x = 0
    have h2 : (2 : ℝ) • lieBracket ℝ (f : E → E) f x = 0 := by rw [two_smul]; nth_rw 1 [h]; simp
    exact (smul_eq_zero.1 h2).resolve_left two_ne_zero
  leibniz_lie f g h := by
    apply Subtype.ext; funext x
    exact leibniz_identity_lieBracket (n := ∞) (by simp) (mem_smoothFields.1 f.2).contDiffAt
      (mem_smoothFields.1 g.2).contDiffAt (mem_smoothFields.1 h.2).contDiffAt

/-- **MLS Definition 7.1, p. 326: `X(E)` is a real Lie algebra:** the bracket is bilinear. -/
instance : LieAlgebra ℝ (smoothFields E) where
  lie_smul c f g := by
    apply Subtype.ext; funext x
    exact lieBracket_const_smul_right ((mem_smoothFields.1 g.2).differentiable (by simp) x)

/-- **MLS Definition 7.1, p. 326: smooth generators as elements of `X(E)`.** -/
def smoothGenerators {m : ℕ} (g : Fin m → E → E) (hg : ∀ j, ContDiff ℝ ∞ (g j)) :
    Fin m → smoothFields E :=
  fun j => ⟨g j, hg j⟩

/-- **MLS Definition 7.1, p. 326: every member of `L(g₁, …, g_m)` is smooth** when the
generators are. -/
theorem InLieAlgebra.contDiff {m : ℕ} {g : Fin m → E → E} (hg : ∀ j, ContDiff ℝ ∞ (g j))
    {f : E → E} (hf : InLieAlgebra g f) : ContDiff ℝ ∞ f := by
  induction hf with
  | gen j => exact hg j
  | add _ _ ihf ihh => exact ihf.add ihh
  | smul c _ ih => exact contDiff_const.smul ih
  | bracket _ _ ihf ihh =>
    exact ContDiff.lieBracket_vectorField (m := ∞) (n := ∞) ihf ihh (by simp)

/-- **MLS Definition 7.1, p. 326: `Δ̄ = L(g₁, …, g_m)` is the Lie algebra generated by
`g₁, …, g_m`:** for smooth generators (and `m ≥ 1`, so that `0` is a combination of them), a field
lies in the library's `L(g₁, …, g_m)` exactly when it is an element of Mathlib's Lie subalgebra of
`X(E)` generated by the generators. -/
theorem inLieAlgebra_iff_mem_lieSpan {m : ℕ} [NeZero m] {g : Fin m → E → E}
    (hg : ∀ j, ContDiff ℝ ∞ (g j)) {f : E → E} :
    InLieAlgebra g f ↔ ∃ X ∈ LieSubalgebra.lieSpan ℝ (smoothFields E)
      (Set.range (smoothGenerators g hg)), (X : E → E) = f := by
  constructor
  · intro hf
    induction hf with
    | gen j => exact ⟨smoothGenerators g hg j, LieSubalgebra.subset_lieSpan ⟨j, rfl⟩, rfl⟩
    | add _ _ ihf ihh =>
      obtain ⟨X, hX, rfl⟩ := ihf
      obtain ⟨Y, hY, rfl⟩ := ihh
      exact ⟨X + Y, LieSubalgebra.add_mem _ hX hY, rfl⟩
    | smul c _ ih =>
      obtain ⟨X, hX, rfl⟩ := ih
      exact ⟨c • X, LieSubalgebra.smul_mem _ c hX, rfl⟩
    | bracket _ _ ihf ihh =>
      obtain ⟨X, hX, rfl⟩ := ihf
      obtain ⟨Y, hY, rfl⟩ := ihh
      exact ⟨⁅X, Y⁆, LieSubalgebra.lie_mem _ hX hY, rfl⟩
  · rintro ⟨X, hX, rfl⟩
    induction hX using LieSubalgebra.lieSpan_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      exact InLieAlgebra.gen j
    | zero =>
      have h := InLieAlgebra.smul 0 (InLieAlgebra.gen (g := g) (0 : Fin m))
      simpa using h
    | add x y _ _ hx hy => exact InLieAlgebra.add hx hy
    | smul a x _ hx => exact InLieAlgebra.smul a hx
    | lie x y _ _ hx hy => exact InLieAlgebra.bracket hx hy

/-- **MLS Definition 7.1, p. 326: "in fact the smallest Lie algebra containing `g₁, …, g_m`":**
every member of `L(g₁, …, g_m)` lies in every Lie subalgebra of `X(E)` that contains the smooth
generators. -/
theorem InLieAlgebra.mem_of_le {m : ℕ} {g : Fin m → E → E} (hg : ∀ j, ContDiff ℝ ∞ (g j))
    {f : E → E} (hf : InLieAlgebra g f) (K : LieSubalgebra ℝ (smoothFields E))
    (hK : ∀ j, smoothGenerators g hg j ∈ K) : ∃ X ∈ K, (X : E → E) = f := by
  induction hf with
  | gen j => exact ⟨_, hK j, rfl⟩
  | add _ _ ihf ihh =>
    obtain ⟨X, hX, rfl⟩ := ihf
    obtain ⟨Y, hY, rfl⟩ := ihh
    exact ⟨X + Y, K.add_mem hX hY, rfl⟩
  | smul c _ ih =>
    obtain ⟨X, hX, rfl⟩ := ih
    exact ⟨c • X, K.smul_mem c hX, rfl⟩
  | bracket _ _ ihf ihh =>
    obtain ⟨X, hX, rfl⟩ := ihf
    obtain ⟨Y, hY, rfl⟩ := ihh
    exact ⟨⁅X, Y⁆, K.lie_mem hX hY, rfl⟩

/-- **MLS pp. 326 and 329: the rank of the controllability Lie algebra at `q`** is the dimension
of the values at `q` of Mathlib's Lie subalgebra of `X(E)` generated by the smooth generators. -/
theorem lieAlgebraAt_eq_span_lieSpan {m : ℕ} [NeZero m] {g : Fin m → E → E}
    (hg : ∀ j, ContDiff ℝ ∞ (g j)) (q : E) :
    lieAlgebraAt g q = Submodule.span ℝ ((fun X : smoothFields E => (X : E → E) q) ''
      (LieSubalgebra.lieSpan ℝ (smoothFields E) (Set.range (smoothGenerators g hg)) :
        Set (smoothFields E))) := by
  unfold lieAlgebraAt spanAt
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq, Set.mem_image, SetLike.mem_coe]
  constructor
  · rintro ⟨f, hf, rfl⟩
    obtain ⟨X, hX, rfl⟩ := (inLieAlgebra_iff_mem_lieSpan hg).1 hf
    exact ⟨X, hX, rfl⟩
  · rintro ⟨X, hX, rfl⟩
    exact ⟨X, (inLieAlgebra_iff_mem_lieSpan hg).2 ⟨X, hX, rfl⟩, rfl⟩

end Nonholonomic
end RoboLean
