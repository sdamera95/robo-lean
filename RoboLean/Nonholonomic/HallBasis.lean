import RoboLean.Nonholonomic.PhilipHall
import RoboLean.Nonholonomic.SevenRemainderFields
import Mathlib.Algebra.Lie.Free

/-!
# The basis property of the Philip Hall basis (MLS §7.4.3, p. 345)

**What MLS prints.** "The proof that a Philip Hall basis is indeed a basis for the Lie algebra
generated by `{g₁, …, g_m}` is beyond the scope of this book and may be found in [38] and [104]"
(p. 345); Example 7.12: "A basis for the nilpotent Lie algebra of order 3 generated by
`g₁, g₂, g₃` is" the fourteen listed products (p. 345).

**Reading.** For vector fields the claim cannot hold literally: the evaluated Hall products need
not be linearly independent (two commuting constant fields on `ℝ²` already give `[g₁, g₂] = 0`;
in the examples file). The basis property is a statement about the free Lie algebra, where the
Hall products are independent and span; in any Lie algebra, and so in `L(g₁, …, g_m)`, only the
spanning half survives. Both halves are separated here.

**Formalized here.**
* Lie products evaluated in any Lie ring (`LieProduct.evalIn`), with the evaluation on smooth fields
  as the evaluation in the Lie algebra `X(E)` (`eval_eq_evalIn`).
* The Lie subalgebra generated by `x₁, …, x_m` is the linear span of the evaluated Lie products of
  all lengths (`lieSpan_eq_span_evalIn`), so the brackets of the generators span `L(g₁, …, g_m)`.
* Example 7.12, spanning half: in any Lie algebra, every Lie product of length at most 3 in three
  elements is a combination of the fourteen Hall products (`evalIn_mem_span_hallUpToThree`); for a
  Lie algebra nilpotent of order 3 the fourteen span the Lie subalgebra they generate
  (`lieSpan_eq_span_hallUpToThree`); for smooth fields `g₁, g₂, g₃` whose Lie products of length
  above 3 vanish, every member of `L(g₁, g₂, g₃)` is a real combination of the fourteen Hall fields
  and the rank of `L(g₁, g₂, g₃)` at `q` is the dimension of the span of their values.
* The basis property for every number of generators and every length, in Mathlib's free Lie
  algebra, as the named statement `HallBasisStatement` (not proved: MLS cites it).
-/

noncomputable section

open scoped ContDiff

namespace RoboLean
namespace Nonholonomic
namespace LieProduct

variable {m : ℕ}

/-- **MLS p. 344: the value of a Lie product in a Lie ring `L`** at the elements `x₁, …, x_m`:
`xᵢ` for a generator and `⁅evalIn A, evalIn B⁆` for `[A, B]`. -/
def evalIn {L : Type*} [LieRing L] (x : Fin m → L) : LieProduct m → L
  | gen i => x i
  | br a b => ⁅evalIn x a, evalIn x b⁆

/-- **MLS p. 344 and Definition 7.1, p. 326:** for smooth fields, the field of a Lie product is
its value in the Lie algebra `X(E)` of smooth fields. -/
theorem eval_eq_evalIn {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {g : Fin m → E → E}
    (hg : ∀ j, ContDiff ℝ ∞ (g j)) (A : LieProduct m) :
    eval g A = ((evalIn (smoothGenerators g hg) A : smoothFields E) : E → E) := by
  induction A with
  | gen i => rfl
  | br a b iha ihb =>
    change VectorField.lieBracket ℝ (eval g a) (eval g b) = _
    rw [iha, ihb]
    rfl

section LieAlgebra

variable {R : Type*} [CommRing R] {L : Type*} [LieRing L] [LieAlgebra R L]

/-- **MLS p. 326: "elements of `L(g₁, …, g_m)` are obtained by taking all linear combinations of
elements of `g₁, …, g_m`, taking Lie brackets of these, taking all linear combinations of these,
and so on":** the Lie subalgebra generated by `x₁, …, x_m` is the linear span of the values of all
Lie products. -/
theorem lieSpan_eq_span_evalIn (x : Fin m → L) :
    (LieSubalgebra.lieSpan R L (Set.range x)).toSubmodule =
      Submodule.span R (Set.range (evalIn x)) := by
  apply le_antisymm
  · have hlie : ∀ a ∈ Submodule.span R (Set.range (evalIn x)),
        ∀ b ∈ Submodule.span R (Set.range (evalIn x)),
          ⁅a, b⁆ ∈ Submodule.span R (Set.range (evalIn x)) := by
      intro a ha b hb
      induction ha using Submodule.span_induction with
      | mem a ha =>
        induction hb using Submodule.span_induction with
        | mem b hb =>
          obtain ⟨A, rfl⟩ := ha
          obtain ⟨B, rfl⟩ := hb
          exact Submodule.subset_span ⟨br A B, rfl⟩
        | zero => simp
        | add b c _ _ hb hc => rw [lie_add]; exact Submodule.add_mem _ hb hc
        | smul r b _ hb => rw [lie_smul]; exact Submodule.smul_mem _ r hb
      | zero => simp
      | add a c _ _ ha hc => rw [add_lie]; exact Submodule.add_mem _ ha hc
      | smul r a _ ha => rw [smul_lie]; exact Submodule.smul_mem _ r ha
    let K : LieSubalgebra R L :=
      { Submodule.span R (Set.range (evalIn x)) with lie_mem' := fun ha hb => hlie _ ha _ hb }
    have hK : LieSubalgebra.lieSpan R L (Set.range x) ≤ K := by
      rw [LieSubalgebra.lieSpan_le]
      rintro _ ⟨i, rfl⟩
      exact Submodule.subset_span ⟨gen i, rfl⟩
    exact hK
  · rw [Submodule.span_le]
    rintro _ ⟨A, rfl⟩
    show evalIn x A ∈ LieSubalgebra.lieSpan R L (Set.range x)
    induction A with
    | gen i => exact LieSubalgebra.subset_lieSpan ⟨i, rfl⟩
    | br a b iha ihb => exact LieSubalgebra.lie_mem _ iha ihb

/-- **MLS p. 344:** every Lie product has length at least one. -/
theorem length_pos (A : LieProduct m) : 1 ≤ A.length := by
  induction A with
  | gen i => simp [length]
  | br a b iha _ => simp only [length]; omega

/-- **MLS Example 7.12, p. 345: the fourteen Hall products of length at most 3 in three
generators.** -/
def hallUpToThree : List (LieProduct 3) := hallOfLength 3 1 ++ hallOfLength 3 2 ++ hallOfLength 3 3

/-- **MLS Example 7.12, p. 345:** there are fourteen of them. -/
theorem hallUpToThree_length : hallUpToThree.length = 14 := by decide

/-- The span of the values of the fourteen Hall products (for MLS Example 7.12, p. 345). -/
abbrev hallSpan (R : Type*) [CommRing R] {L : Type*} [LieRing L] [LieAlgebra R L]
    (x : Fin 3 → L) : Submodule R L :=
  Submodule.span R ((evalIn x) '' {B | B ∈ hallUpToThree})

/-- **MLS Example 7.12, p. 345:** the value of a Hall product of length at most 3 lies in the span
of the fourteen. -/
theorem evalIn_mem_hallSpan (x : Fin 3 → L) {B : LieProduct 3} (hB : B ∈ hallUpToThree) :
    evalIn x B ∈ hallSpan R x :=
  Submodule.subset_span ⟨B, hB, rfl⟩

/-- **MLS Example 7.12, p. 345, length 2:** `[xₐ, x_b]` is a Hall product, zero, or the negative
of one (skew-symmetry, Proposition 7.1(1)). -/
theorem lie_gen_gen_mem_hallSpan (x : Fin 3 → L) (a b : Fin 3) :
    ⁅x a, x b⁆ ∈ hallSpan R x := by
  fin_cases a <;> fin_cases b <;>
  first
  | exact evalIn_mem_hallSpan (R := R) x (B := br (gen _) (gen _)) (by decide)
  | (rw [lie_self]; exact Submodule.zero_mem _)
  | (rw [← lie_skew]; exact Submodule.neg_mem _
      (evalIn_mem_hallSpan (R := R) x (B := br (gen _) (gen _)) (by decide)))

/-- **MLS Example 7.12, p. 345, length 3 with `b < c`:** `[xₐ, [x_b, x_c]]` is a Hall product,
except `[x₁, [x₂, x₃]] = [x₂, [x₁, x₃]] − [x₃, [x₁, x₂]]` (the Jacobi identity, as printed). -/
theorem lie_gen_lie_mem_hallSpan_of_lt (x : Fin 3 → L) (a b c : Fin 3) (hbc : b < c) :
    ⁅x a, ⁅x b, x c⁆⁆ ∈ hallSpan R x := by
  have jac : ⁅x 0, ⁅x 1, x 2⁆⁆ = ⁅x 1, ⁅x 0, x 2⁆⁆ - ⁅x 2, ⁅x 0, x 1⁆⁆ := by
    rw [leibniz_lie, ← lie_skew ⁅x 0, x 1⁆ (x 2)]
    abel
  have j012 : ⁅x 0, ⁅x 1, x 2⁆⁆ ∈ hallSpan R x := by
    rw [jac]
    exact Submodule.sub_mem _
      (evalIn_mem_hallSpan (R := R) x (B := br (gen 1) (br (gen 0) (gen 2))) (by decide))
      (evalIn_mem_hallSpan (R := R) x (B := br (gen 2) (br (gen 0) (gen 1))) (by decide))
  fin_cases a <;> fin_cases b <;> fin_cases c <;>
  first
  | exact absurd hbc (by decide)
  | exact evalIn_mem_hallSpan (R := R) x (B := br (gen _) (br (gen _) (gen _))) (by decide)
  | exact j012

/-- **MLS Example 7.12, p. 345, length 3:** every `[xₐ, [x_b, x_c]]` lies in the span of the
fourteen Hall products. -/
theorem lie_gen_lie_mem_hallSpan (x : Fin 3 → L) (a b c : Fin 3) :
    ⁅x a, ⁅x b, x c⁆⁆ ∈ hallSpan R x := by
  rcases lt_trichotomy b c with h | rfl | h
  · exact lie_gen_lie_mem_hallSpan_of_lt x a b c h
  · rw [lie_self, lie_zero]
    exact Submodule.zero_mem _
  · rw [← lie_skew (x b) (x c), lie_neg]
    exact Submodule.neg_mem _ (lie_gen_lie_mem_hallSpan_of_lt x a c b h)

/-- **MLS Example 7.12, p. 345, spanning half:** in any Lie algebra, every Lie product of length
at most 3 in three elements is a linear combination of the fourteen Hall products (`[g₁, [g₂, g₃]]`
through the Jacobi identity, the others by skew-symmetry). -/
theorem evalIn_mem_span_hallUpToThree (x : Fin 3 → L) (A : LieProduct 3) (hA : A.length ≤ 3) :
    evalIn x A ∈ hallSpan R x := by
  rcases A with i | ⟨a, b⟩
  · exact evalIn_mem_hallSpan (R := R) x (B := gen i) (by fin_cases i <;> decide)
  · rcases a with a | ⟨a₁, a₂⟩ <;> rcases b with b | ⟨b₁, b₂⟩
    · exact lie_gen_gen_mem_hallSpan x a b
    · rcases b₁ with b₁ | ⟨c₁, c₂⟩ <;> rcases b₂ with b₂ | ⟨d₁, d₂⟩
      · exact lie_gen_lie_mem_hallSpan x a b₁ b₂
      · simp only [length] at hA; have := length_pos d₁; have := length_pos d₂; omega
      · simp only [length] at hA; have := length_pos c₁; have := length_pos c₂; omega
      · simp only [length] at hA; have := length_pos c₁; have := length_pos c₂; have := length_pos d₁
        omega
    · rcases a₁ with a₁ | ⟨c₁, c₂⟩ <;> rcases a₂ with a₂ | ⟨d₁, d₂⟩
      · change ⁅⁅x a₁, x a₂⁆, x b⁆ ∈ hallSpan R x
        rw [← lie_skew]
        exact Submodule.neg_mem _ (lie_gen_lie_mem_hallSpan x b a₁ a₂)
      · simp only [length] at hA; have := length_pos d₁; have := length_pos d₂; omega
      · simp only [length] at hA; have := length_pos c₁; have := length_pos c₂; omega
      · simp only [length] at hA; have := length_pos c₁; have := length_pos c₂; have := length_pos d₁
        omega
    · simp only [length] at hA
      have := length_pos a₁; have := length_pos a₂; have := length_pos b₁; have := length_pos b₂
      omega

/-- **MLS Example 7.12, p. 345, spanning half: "a basis for the nilpotent Lie algebra of order 3
generated by `g₁, g₂, g₃`":** if every Lie product of length greater than 3 vanishes (nilpotent of
order 3, p. 344), the fourteen Hall products span the Lie subalgebra generated by `x₁, x₂, x₃`. -/
theorem lieSpan_eq_span_hallUpToThree (x : Fin 3 → L)
    (hnil : ∀ A : LieProduct 3, 3 < A.length → evalIn x A = 0) :
    (LieSubalgebra.lieSpan R L (Set.range x)).toSubmodule = hallSpan R x := by
  rw [lieSpan_eq_span_evalIn]
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨A, rfl⟩
    by_cases hA : A.length ≤ 3
    · exact evalIn_mem_span_hallUpToThree x A hA
    · rw [hnil A (by omega)]
      exact Submodule.zero_mem _
  · apply Submodule.span_mono
    rintro _ ⟨B, -, rfl⟩
    exact ⟨B, rfl⟩

end LieAlgebra

section Fields

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- **MLS Example 7.12, p. 345, for vector fields (spanning half):** for smooth fields
`g₁, g₂, g₃` whose Lie products of length greater than 3 all vanish, every member of
`L(g₁, g₂, g₃)` is a real linear combination of the fourteen Hall fields. -/
theorem inLieAlgebra_mem_span_hallUpToThree {g : Fin 3 → E → E} (hg : ∀ j, ContDiff ℝ ∞ (g j))
    (hnil : ∀ A : LieProduct 3, 3 < A.length → eval g A = 0) {f : E → E}
    (hf : InLieAlgebra g f) :
    f ∈ Submodule.span ℝ ((eval g) '' {B | B ∈ hallUpToThree}) := by
  obtain ⟨X, hX, rfl⟩ := (inLieAlgebra_iff_mem_lieSpan hg).1 hf
  have hnil' : ∀ A : LieProduct 3, 3 < A.length → evalIn (smoothGenerators g hg) A = 0 := by
    intro A hA
    apply Subtype.ext
    rw [← eval_eq_evalIn hg]
    exact hnil A hA
  have hX' : X ∈ hallSpan ℝ (smoothGenerators g hg) := by
    rw [← lieSpan_eq_span_hallUpToThree _ hnil']
    exact hX
  have hmap : Submodule.map (smoothFields E).subtype (hallSpan ℝ (smoothGenerators g hg)) =
      Submodule.span ℝ ((eval g) '' {B | B ∈ hallUpToThree}) := by
    rw [Submodule.map_span, ← Set.image_comp]
    congr 1
    apply Set.image_congr
    intro B _
    simp [eval_eq_evalIn hg]
  rw [← hmap]
  exact ⟨X, hX', rfl⟩

/-- **MLS pp. 329 and 345: the rank of `L(g₁, g₂, g₃)` at `q` for a Lie algebra nilpotent of order
3** is the dimension of the span of the values at `q` of the fourteen Hall fields. -/
theorem lieAlgebraAt_eq_span_hallUpToThree {g : Fin 3 → E → E} (hg : ∀ j, ContDiff ℝ ∞ (g j))
    (hnil : ∀ A : LieProduct 3, 3 < A.length → eval g A = 0) (q : E) :
    lieAlgebraAt g q = Submodule.span ℝ ((fun B => eval g B q) '' {B | B ∈ hallUpToThree}) := by
  apply le_antisymm
  · unfold lieAlgebraAt spanAt
    rw [Submodule.span_le]
    rintro _ ⟨f, hf, rfl⟩
    have h := inLieAlgebra_mem_span_hallUpToThree hg hnil hf
    have hev : Submodule.map (LinearMap.proj (R := ℝ) (φ := fun _ : E => E) q)
        (Submodule.span ℝ ((eval g) '' {B | B ∈ hallUpToThree})) =
        Submodule.span ℝ ((fun B => eval g B q) '' {B | B ∈ hallUpToThree}) := by
      rw [Submodule.map_span, ← Set.image_comp]
      rfl
    rw [SetLike.mem_coe, ← hev]
    exact ⟨f, h, rfl⟩
  · rw [Submodule.span_le]
    rintro _ ⟨B, -, rfl⟩
    exact mem_spanAt (inLieAlgebra_eval g B) q

end Fields

/-- **MLS p. 345, the basis property, as a named statement (not proved; MLS cites [38] and
[104]):** for every number `m` of generators, the values of the Philip Hall products (condition 3
read recursively, with the library's order refining the length) in Mathlib's free Lie algebra on
`m` generators over `ℝ` are linearly independent and span it. -/
def HallBasisStatement : Prop :=
  ∀ m : ℕ,
    LinearIndependent ℝ (fun B : {B : LieProduct m // IsHall B = true} =>
        evalIn (FreeLieAlgebra.of ℝ (X := Fin m)) B.1) ∧
      Submodule.span ℝ (Set.range fun B : {B : LieProduct m // IsHall B = true} =>
        evalIn (FreeLieAlgebra.of ℝ (X := Fin m)) B.1) = ⊤

end LieProduct
end Nonholonomic
end RoboLean
