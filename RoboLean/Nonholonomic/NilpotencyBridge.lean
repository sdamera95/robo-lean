import RoboLean.Nonholonomic.Nilpotent
import RoboLean.Nonholonomic.HallBasis

/-!
# Nilpotency on fields and on formal products: Example 7.12 through `IsNilpotentOfOrder`

MLS Chapter 7, printed p. 344: "A Lie algebra is nilpotent if there exists an integer `k` such that
all Lie products of length greater than `k` are zero. The integer `k` is called the order of
nilpotency"; Example 7.12, p. 345: "A basis for the nilpotent Lie algebra of order 3 generated by
`g₁, g₂, g₃` is" the fourteen listed products.

**Proved here.**

* The two readings of "nilpotent of order `k`" agree: `IsNilpotentOfOrder g k` (every Lie product
  of the fields of length greater than `k` is the zero field) holds exactly when every formal Lie
  product of length greater than `k` evaluates to zero on the fields
  (`isNilpotentOfOrder_iff_eval`), and, for smooth fields, exactly when its value in the Lie algebra
  of smooth fields is zero (`isNilpotentOfOrder_iff_evalIn`), the hypothesis of the spanning half of
  Example 7.12 in a Lie ring.
* The spanning half of Example 7.12 restated through `IsNilpotentOfOrder`: for smooth
  `g₁, g₂, g₃` nilpotent of order 3, every member of `L(g₁, g₂, g₃)` is a combination of the
  fourteen Hall fields (`inLieAlgebra_mem_span_hallUpToThree_of_isNilpotentOfOrder`) and their
  values at `q` span `L(g₁, g₂, g₃)(q)`
  (`lieAlgebraAt_eq_span_hallUpToThree_of_isNilpotentOfOrder`).
* Nilpotency passes to fields that are themselves Lie products of the generators: if every `g'ⱼ`
  is a Lie product of `g₁, …, g_m` and `g` is nilpotent of order `k`, so is `g'`
  (`IsNilpotentOfOrder.of_isLieProduct`), and `L(g)` lies in `L(g')` when every `gᵢ` lies in
  `L(g')` (`inLieAlgebra_of_inLieAlgebra`).

**Conventions.** `IsLieProduct`, `IsNilpotentOfOrder` and `lieAlgebraAt` as in the library's
Chapter 7 modules; formal products `LieProduct m` with `LieProduct.eval` and `LieProduct.evalIn`;
the bracket is Mathlib's `lieBracket`, the convention of MLS p. 323.
-/

noncomputable section

open scoped ContDiff

namespace RoboLean
namespace Nonholonomic

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {m : ℕ}

/-- **MLS p. 344: nilpotency of order `k` read on formal products:** every Lie product of the fields
of length greater than `k` is zero exactly when every formal Lie product of length greater than `k`
evaluates to the zero field. -/
theorem isNilpotentOfOrder_iff_eval {g : Fin m → E → E} {k : ℕ} :
    IsNilpotentOfOrder g k ↔ ∀ A : LieProduct m, k < A.length → LieProduct.eval g A = 0 :=
  isNilpotentOfOrder_iff

/-- **MLS p. 344 and Definition 7.1, p. 326: nilpotency of order `k` in the Lie algebra of smooth
fields:** for smooth fields, `IsNilpotentOfOrder g k` holds exactly when every formal Lie product
of length greater than `k` has value zero at the generators in the Lie algebra `X(E)` of smooth
fields (the hypothesis of the spanning half of Example 7.12 in a Lie ring). -/
theorem isNilpotentOfOrder_iff_evalIn {g : Fin m → E → E} (hg : ∀ j, ContDiff ℝ ∞ (g j))
    {k : ℕ} :
    IsNilpotentOfOrder g k ↔
      ∀ A : LieProduct m, k < A.length → LieProduct.evalIn (smoothGenerators g hg) A = 0 := by
  rw [isNilpotentOfOrder_iff_eval]
  refine forall_congr' fun A => imp_congr_right fun _ => ?_
  rw [LieProduct.eval_eq_evalIn hg]
  constructor
  · intro h
    exact Subtype.ext h
  · intro h
    rw [h]
    rfl

/-- **MLS Example 7.12, p. 345, spanning half, through `IsNilpotentOfOrder`:** for smooth
`g₁, g₂, g₃` nilpotent of order 3 (p. 344), every member of `L(g₁, g₂, g₃)` is a real combination
of the fourteen Hall fields of length at most 3. -/
theorem inLieAlgebra_mem_span_hallUpToThree_of_isNilpotentOfOrder {g : Fin 3 → E → E}
    (hg : ∀ j, ContDiff ℝ ∞ (g j)) (hnil : IsNilpotentOfOrder g 3) {f : E → E}
    (hf : InLieAlgebra g f) :
    f ∈ Submodule.span ℝ ((LieProduct.eval g) '' {B | B ∈ LieProduct.hallUpToThree}) :=
  LieProduct.inLieAlgebra_mem_span_hallUpToThree hg (isNilpotentOfOrder_iff_eval.1 hnil) hf

/-- **MLS Example 7.12, p. 345, spanning half, through `IsNilpotentOfOrder`, at a point:** for
smooth `g₁, g₂, g₃` nilpotent of order 3 (p. 344), `L(g₁, g₂, g₃)(q)` is the span of the values at
`q` of the fourteen Hall fields, so its rank is the dimension of that span. -/
theorem lieAlgebraAt_eq_span_hallUpToThree_of_isNilpotentOfOrder {g : Fin 3 → E → E}
    (hg : ∀ j, ContDiff ℝ ∞ (g j)) (hnil : IsNilpotentOfOrder g 3) (q : E) :
    lieAlgebraAt g q = Submodule.span ℝ
      ((fun B => LieProduct.eval g B q) '' {B | B ∈ LieProduct.hallUpToThree}) :=
  LieProduct.lieAlgebraAt_eq_span_hallUpToThree hg (isNilpotentOfOrder_iff_eval.1 hnil) q

/-- **MLS p. 344: a Lie product of Lie products is a Lie product at least as long:** if every
`g'ⱼ` is a Lie product of `g₁, …, g_m`, a Lie product of the `g'ⱼ` of length `l` is a Lie product of
the `gᵢ` of some length `l' ≥ l`. -/
theorem IsLieProduct.of_isLieProduct {m' : ℕ} {g : Fin m → E → E} {g' : Fin m' → E → E}
    (hg' : ∀ j, ∃ l, IsLieProduct g l (g' j)) {l : ℕ} {A : E → E} (hA : IsLieProduct g' l A) :
    ∃ l', l ≤ l' ∧ IsLieProduct g l' A := by
  induction hA with
  | gen j =>
    obtain ⟨l, hl⟩ := hg' j
    exact ⟨l, hl.one_le, hl⟩
  | bracket _ _ iha ihb =>
    obtain ⟨a', ha, hA⟩ := iha
    obtain ⟨b', hb, hB⟩ := ihb
    exact ⟨a' + b', by omega, IsLieProduct.bracket hA hB⟩

/-- **MLS p. 344: nilpotency passes to Lie products of the generators:** if every `g'ⱼ` is a Lie
product of `g₁, …, g_m` and `g` is nilpotent of order `k`, then so is `g'`. -/
theorem IsNilpotentOfOrder.of_isLieProduct {m' : ℕ} {g : Fin m → E → E} {g' : Fin m' → E → E}
    {k : ℕ} (h : IsNilpotentOfOrder g k) (hg' : ∀ j, ∃ l, IsLieProduct g l (g' j)) :
    IsNilpotentOfOrder g' k := by
  intro l A hA hl
  obtain ⟨l', hll', hA'⟩ := IsLieProduct.of_isLieProduct hg' hA
  exact h l' A hA' (lt_of_lt_of_le hl hll')

/-- **MLS Definition 7.1, p. 326: `L(g) ⊆ L(g')` when the generators of `g` lie in `L(g')`.** -/
theorem inLieAlgebra_of_inLieAlgebra {m' : ℕ} {g : Fin m → E → E} {g' : Fin m' → E → E}
    (hg : ∀ i, InLieAlgebra g' (g i)) {f : E → E} (hf : InLieAlgebra g f) : InLieAlgebra g' f := by
  induction hf with
  | gen i => exact hg i
  | add _ _ ihf ihh => exact InLieAlgebra.add ihf ihh
  | smul c _ ih => exact InLieAlgebra.smul c ih
  | bracket _ _ ihf ihh => exact InLieAlgebra.bracket ihf ihh

/-- **MLS pp. 326 and 329: `L(g)(q) ≤ L(g')(q)` when the generators of `g` lie in `L(g')`.** -/
theorem lieAlgebraAt_le_of_inLieAlgebra {m' : ℕ} {g : Fin m → E → E} {g' : Fin m' → E → E}
    (hg : ∀ i, InLieAlgebra g' (g i)) (q : E) : lieAlgebraAt g q ≤ lieAlgebraAt g' q :=
  spanAt_mono (fun _ hf => inLieAlgebra_of_inLieAlgebra hg hf) q

end Nonholonomic
end RoboLean
