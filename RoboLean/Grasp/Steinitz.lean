import RoboLean.Grasp.ExceptionalSurface

/-!
# Steinitz's theorem (Theorem 5.5) and at most `2p` frictionless contacts

MLS Chapter 5, §4.1, printed p. 230: "**Theorem 5.5** (Steinitz). If `S ⊂ ℝ^p` and
`q ∈ int(co S)`, then there exists `X = {v₁, …, v_k} ⊂ S` such that `q ∈ int(co X)` and
`k ≤ 2p`." No proof is printed. Its use on pp. 230–231: with `S = Λ(Σ)` and `q = 0`, "Steinitz's
theorem guarantees that we need at most `2p` contacts to grasp any non-exceptional object", and
"`p = 3` (planar) ⟹ `4 ≤ k ≤ 6`; `p = 6` (spatial) ⟹ `7 ≤ k ≤ 12`".

Added hypothesis: `p ≥ 1`. For `p = 0` the printed statement fails (`S = {0}`, `q = 0`: every
`X` with `q ∈ int(co X)` is nonempty, so `k ≥ 1 > 2p`).

Proof route (a simplification of Bárány and Qi, arXiv 2512.22907, §2, which picks a generic
vector; here genericity is not needed). By the weak bound
`exists_finset_mem_interior_convexHull_card_le_sq` reduce to a finite `X₀ ⊂ S`; the vectors
`x - q`, `x ∈ X₀`, positively span. Pick among them a basis `b` (at most `p` vectors) and let
`v = ∑ b`, an interior point of the cone generated by `b`; by the conic Carathéodory lemma `-v`
is a nonnegative combination of at most `p` linearly independent vectors `x - q`. The at most
`2p` points of `X₀` involved positively span around `q`: `t w = (v + t w) + (-v)` for small
`t > 0`. Proposition 5.3 (2) ⟹ (3) gives `q ∈ int(co X)`.

Conventions as in `PositiveSpanBounds`: `co` is `convexHull ℝ`, `int` is `interior`, `ℝ^p` is a
real normed space of finite dimension `p` (the printed `Fin p → ℝ` in `_fin` forms). Finite-force
caveat: force-closure assumes unbounded contact forces at maintained rigid contacts
(MLS p. 214).
-/

noncomputable section

open Matrix

namespace RoboLean.Grasp

/-- One reduction step of the conic Carathéodory lemma: a relation `∑_{i ∈ s} cᵢ vᵢ = 0` with some
`cⱼ > 0` lets one coefficient of a nonnegative combination over `s` drop to zero. -/
private theorem conic_step {ι W : Type*} [AddCommGroup W] [Module ℝ W] [DecidableEq ι]
    (v : ι → W) {s : Finset ι} {α c : ι → ℝ} (hα : ∀ i, 0 ≤ α i) (hc0 : ∀ i ∉ s, c i = 0)
    (hc : ∑ i ∈ s, c i • v i = 0) {j : ι} (hjs : j ∈ s) (hj : 0 < c j) :
    ∃ i₀ ∈ s, ∃ α' : ι → ℝ, (∀ i, 0 ≤ α' i) ∧
      ∑ i ∈ s.erase i₀, α' i • v i = ∑ i ∈ s, α i • v i := by
  obtain ⟨i₀, hi₀P, hmin⟩ := (s.filter fun i => 0 < c i).exists_min_image
    (fun i => α i / c i) ⟨j, Finset.mem_filter.mpr ⟨hjs, hj⟩⟩
  obtain ⟨hi₀s, hci₀⟩ := Finset.mem_filter.mp hi₀P
  have ht0 : 0 ≤ α i₀ / c i₀ := div_nonneg (hα i₀) hci₀.le
  refine ⟨i₀, hi₀s, fun i => α i - α i₀ / c i₀ * c i, fun i => ?_, ?_⟩
  · by_cases hci : 0 < c i
    · have his : i ∈ s := by
        by_contra h
        rw [hc0 i h] at hci
        exact lt_irrefl _ hci
      have hle := (le_div_iff₀ hci).mp (hmin i (Finset.mem_filter.mpr ⟨his, hci⟩))
      exact sub_nonneg.mpr hle
    · have hle := mul_nonpos_of_nonneg_of_nonpos ht0 (not_lt.mp hci)
      linarith [hα i]
  · rw [Finset.sum_erase]
    · simp only [sub_smul, mul_smul, Finset.sum_sub_distrib, ← Finset.smul_sum, hc, smul_zero,
        sub_zero]
    · show (α i₀ - α i₀ / c i₀ * c i₀) • v i₀ = 0
      rw [div_mul_cancel₀ _ hci₀.ne', sub_self, zero_smul]

/-- **Conic Carathéodory lemma** (supporting lemma for MLS Theorem 5.5, printed p. 230; Bárány
and Qi, arXiv 2512.22907, Lemma 2.1): a nonnegative combination of finitely many vectors `vᵢ` is
a nonnegative combination of a linearly independent subfamily. -/
theorem exists_linearIndependent_nonneg_combination {ι W : Type*} [Fintype ι] [AddCommGroup W]
    [Module ℝ W] (v : ι → W) (α : ι → ℝ) (hα : ∀ i, 0 ≤ α i) :
    ∃ (s : Finset ι) (β : ι → ℝ), LinearIndependent ℝ (fun i : s => v i) ∧ (∀ i, 0 ≤ β i) ∧
      ∑ i ∈ s, β i • v i = ∑ i, α i • v i := by
  classical
  suffices key : ∀ s : Finset ι, ∀ α : ι → ℝ, (∀ i, 0 ≤ α i) → ∃ (t : Finset ι) (β : ι → ℝ),
      LinearIndependent ℝ (fun i : t => v i) ∧ (∀ i, 0 ≤ β i) ∧
        ∑ i ∈ t, β i • v i = ∑ i ∈ s, α i • v i from key Finset.univ α hα
  intro s
  induction s using Finset.strongInduction with
  | H s ih =>
    intro α hα
    by_cases hli : LinearIndependent ℝ (fun i : s => v i)
    · exact ⟨s, α, hli, hα, rfl⟩
    obtain ⟨g, hg, j, hj⟩ := Fintype.not_linearIndependent_iff.mp hli
    let c : ι → ℝ := fun i => if h : i ∈ s then g ⟨i, h⟩ else 0
    have hcg : ∀ i : s, c i = g i := fun i => by simp [c]
    have hc0 : ∀ i ∉ s, c i = 0 := fun i hi => by simp [c, hi]
    have hc : ∑ i ∈ s, c i • v i = 0 := by
      rw [← Finset.sum_coe_sort s]
      exact (Finset.sum_congr rfl fun i _ => by rw [hcg i]).trans hg
    have hstep : ∃ i₀ ∈ s, ∃ α' : ι → ℝ, (∀ i, 0 ≤ α' i) ∧
        ∑ i ∈ s.erase i₀, α' i • v i = ∑ i ∈ s, α i • v i := by
      rcases lt_or_gt_of_ne hj with hneg | hpos
      · refine conic_step v (c := -c) hα (fun i hi => by simp [hc0 i hi]) ?_ j.2 ?_
        · simp [neg_smul, Finset.sum_neg_distrib, hc]
        · simpa [hcg j] using hneg
      · exact conic_step v hα hc0 hc j.2 (by rwa [hcg j])
    obtain ⟨i₀, hi₀, α', hα', hsum⟩ := hstep
    obtain ⟨t, β, h1, h2, h3⟩ := ih (s.erase i₀) (Finset.erase_ssubset hi₀) α' hα'
    exact ⟨t, β, h1, h2, h3.trans hsum⟩

/-- If `q` is interior to the convex hull of a finite set `X`, every vector is a nonnegative
combination of the vectors `x - q`, `x ∈ X` (supporting lemma for MLS Theorem 5.5, p. 230). -/
private theorem exists_nonneg_sum_sub_eq {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {X : Finset E} {q : E} (hq : q ∈ interior (convexHull ℝ (X : Set E))) (z : E) :
    ∃ l : E → ℝ, (∀ x ∈ X, 0 ≤ l x) ∧ ∑ x ∈ X, l x • (x - q) = z := by
  have hnhds : convexHull ℝ (X : Set E) ∈ nhds q := mem_interior_iff_mem_nhds.mp hq
  have hcont : Continuous fun t : ℝ => q + t • z :=
    continuous_const.add (continuous_id.smul continuous_const)
  have hpre : (fun t : ℝ => q + t • z) ⁻¹' convexHull ℝ (X : Set E) ∈ nhds (0 : ℝ) :=
    hcont.continuousAt.preimage_mem_nhds (by simpa using hnhds)
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp hpre
  have ht : ε / 2 ∈ Metric.ball (0 : ℝ) ε := by
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_pos (by positivity)]
    linarith
  obtain ⟨w, hw0, hw1, hwz⟩ := Finset.mem_convexHull'.mp (hball ht)
  refine ⟨fun x => (ε / 2)⁻¹ * w x, fun x hx => mul_nonneg (by positivity) (hw0 x hx), ?_⟩
  simp only [mul_smul, ← Finset.smul_sum, smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul,
    hw1, one_smul, hwz]
  rw [smul_add, smul_smul, inv_mul_cancel₀ (by positivity), one_smul, add_sub_cancel_left]

/-- If the vectors `x - q`, `x ∈ X`, of a nonempty finite set `X` have nonnegative combinations
equal to every vector, then `q` is interior to the convex hull of `X` (MLS Proposition 5.3,
(2) ⟹ (3), p. 226, transported to `Fin p → ℝ` and translated by `q`; supporting lemma for MLS
Theorem 5.5, p. 230). -/
private theorem mem_interior_convexHull_of_nonneg_span {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {X : Finset E} {q : E} (hne : X.Nonempty)
    (h : ∀ z, ∃ l : E → ℝ, (∀ x ∈ X, 0 ≤ l x) ∧ ∑ x ∈ X, l x • (x - q) = z) :
    q ∈ interior (convexHull ℝ (X : Set E)) := by
  let e : E ≃L[ℝ] (Fin (Module.finrank ℝ E) → ℝ) :=
    ContinuousLinearEquiv.ofFinrankEq (@Module.finrank_fin_fun ℝ _ _ (Module.finrank ℝ E)).symm
  let w : X → Fin (Module.finrank ℝ E) → ℝ := fun x => e ((x : E) - q)
  have : Nonempty X := hne.coe_sort
  have hw : PositivelySpans w := by
    rw [positivelySpans_iff_nonneg]
    intro z
    obtain ⟨l, hl, hz⟩ := h (e.symm z)
    refine ⟨fun x => l x, fun x => hl x x.2, ?_⟩
    have hsum := Finset.sum_coe_sort X fun x => l x • (x - q)
    rw [hz] at hsum
    simp only [w, ← map_smul, ← map_sum, hsum, ContinuousLinearEquiv.apply_symm_apply]
  have hH := (positivelySpans_iff_convexHull_mem_nhds w).mp hw
  have hconv : Convex ℝ ((fun u => q + e.symm u) ⁻¹' convexHull ℝ (X : Set E)) :=
    ((convex_convexHull ℝ _).translate_preimage_right q).linear_preimage
      (e.symm : (Fin (Module.finrank ℝ E) → ℝ) →ₗ[ℝ] E)
  have hsub : convexHull ℝ (Set.range w) ⊆ (fun u => q + e.symm u) ⁻¹' convexHull ℝ (X : Set E) :=
    convexHull_min (by
      rintro _ ⟨x, rfl⟩
      simpa [w] using subset_convexHull ℝ (X : Set E) x.2) hconv
  have hcont : Continuous fun y : E => e (y - q) := e.continuous.comp (continuous_sub_right q)
  have hpre : (fun y : E => e (y - q)) ⁻¹' convexHull ℝ (Set.range w) ∈ nhds q :=
    hcont.continuousAt.preimage_mem_nhds (by simpa using hH)
  refine mem_interior_iff_mem_nhds.mpr (Filter.mem_of_superset hpre fun y hy => ?_)
  simpa using hsub hy

/-- The combinatorial core of MLS Theorem 5.5 (p. 230), in cone form: if nonnegative combinations
of a finite set `V₀` of vectors give every vector of a space of dimension `p`, then so do those of
some `V ⊆ V₀` with at most `2p` elements (a spanning linearly independent `B ⊆ V₀`, and a linearly
independent `C ⊆ V₀` carrying `-∑ B` by the conic Carathéodory lemma). -/
private theorem exists_subset_card_le_two_mul_nonneg_span {W : Type*} [AddCommGroup W]
    [Module ℝ W] [FiniteDimensional ℝ W] {V₀ : Finset W}
    (h : ∀ z, ∃ l : W → ℝ, (∀ y ∈ V₀, 0 ≤ l y) ∧ ∑ y ∈ V₀, l y • y = z) :
    ∃ V ⊆ V₀, V.card ≤ 2 * Module.finrank ℝ W ∧
      ∀ z, ∃ l : W → ℝ, (∀ y ∈ V, 0 ≤ l y) ∧ ∑ y ∈ V, l y • y = z := by
  classical
  have hspan0 : ∀ z, z ∈ Submodule.span ℝ (V₀ : Set W) := fun z => by
    obtain ⟨l, -, rfl⟩ := h z
    exact Submodule.sum_mem _ fun y hy => Submodule.smul_mem _ _ (Submodule.subset_span hy)
  -- a spanning linearly independent `B ⊆ V₀`
  obtain ⟨b, hbV, hbspan, hbli⟩ := exists_linearIndependent ℝ (V₀ : Set W)
  have : Fintype b := (V₀.finite_toSet.subset hbV).fintype
  set B := b.toFinset with hB
  have hBV : B ⊆ V₀ := fun y hy => hbV (Set.mem_toFinset.mp hy)
  have hBcard : B.card ≤ Module.finrank ℝ W := by
    rw [hB, Set.toFinset_card]
    exact hbli.fintype_card_le_finrank
  have hBspan : ∀ z, z ∈ Submodule.span ℝ (B : Set W) := fun z => by
    rw [hB, Set.coe_toFinset, hbspan]
    exact hspan0 z
  -- `-∑ B` from a linearly independent `C ⊆ V₀`
  obtain ⟨l, hl, hlv⟩ := h (-∑ y ∈ B, y)
  obtain ⟨s, β, hsli, hβ, hsβ⟩ := exists_linearIndependent_nonneg_combination
    (fun y : V₀ => (y : W)) (fun y => l y) (fun y => hl y y.2)
  set C := s.map (Function.Embedding.subtype _) with hC
  have hCV : C ⊆ V₀ := by
    intro y hy
    obtain ⟨i, -, rfl⟩ := Finset.mem_map.mp hy
    exact i.2
  have hCcard : C.card ≤ Module.finrank ℝ W := by
    rw [hC, Finset.card_map, ← Fintype.card_coe]
    exact hsli.fintype_card_le_finrank
  let γ : W → ℝ := fun y => if hy : y ∈ V₀ then β ⟨y, hy⟩ else 0
  have hγ : ∀ y, 0 ≤ γ y := fun y => by
    by_cases hy : y ∈ V₀
    · simp only [γ, hy, dite_true]
      exact hβ _
    · simp [γ, hy]
  have hCsum : ∑ y ∈ C, γ y • y = -∑ y ∈ B, y := by
    rw [hC, Finset.sum_map, ← hlv, ← Finset.sum_coe_sort V₀, ← hsβ]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [γ]
  refine ⟨B ∪ C, Finset.union_subset hBV hCV,
    (Finset.card_union_le B C).trans (by omega), fun z => ?_⟩
  obtain ⟨c, -, hcz⟩ := Submodule.mem_span_finset.mp (hBspan z)
  set M := ∑ y ∈ B, |c y| with hM
  have hM0 : 0 ≤ M := Finset.sum_nonneg fun y _ => abs_nonneg _
  refine ⟨fun y => (if y ∈ B then c y + M else 0) + (if y ∈ C then M * γ y else 0),
    fun y _ => add_nonneg ?_ ?_, ?_⟩
  · split_ifs with hy
    · have h1 : |c y| ≤ M := Finset.single_le_sum (fun y _ => abs_nonneg (c y)) hy
      linarith [neg_abs_le (c y)]
    · exact le_rfl
  · split_ifs
    · exact mul_nonneg hM0 (hγ y)
    · exact le_rfl
  · have e1 : ∀ y, ((if y ∈ B then c y + M else 0) + (if y ∈ C then M * γ y else 0)) • y =
        (if y ∈ B then (c y + M) • y else 0) + (if y ∈ C then M • (γ y • y) else 0) :=
      fun y => by split_ifs <;> simp only [add_smul, mul_smul, zero_smul, add_zero, zero_add]
    rw [Finset.sum_congr rfl fun y _ => e1 y, Finset.sum_add_distrib, Finset.sum_ite_mem,
      Finset.sum_ite_mem, Finset.union_inter_cancel_left, Finset.union_inter_cancel_right,
      ← Finset.smul_sum, hCsum, Finset.sum_congr rfl fun y _ => add_smul (c y) M y,
      Finset.sum_add_distrib, hcz, smul_neg, Finset.smul_sum]
    abel

/-- **MLS Theorem 5.5 (Steinitz)**, printed p. 230: if `q ∈ int(co S)` in a real normed space of
finite dimension `p ≥ 1`, there is a finite `X ⊂ S` with `q ∈ int(co X)` and `|X| ≤ 2p`. Added
hypothesis `p ≥ 1` (the printed statement fails for `p = 0`). -/
theorem exists_finset_mem_interior_convexHull_card_le_two_mul {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] {S : Set E} {q : E}
    (hq : q ∈ interior (convexHull ℝ S)) (hE : 0 < Module.finrank ℝ E) :
    ∃ X : Finset E, (X : Set E) ⊆ S ∧ X.card ≤ 2 * Module.finrank ℝ E ∧
      q ∈ interior (convexHull ℝ (X : Set E)) := by
  classical
  obtain ⟨X₀, hX₀S, -, hX₀q⟩ := exists_finset_mem_interior_convexHull_card_le_sq hq
  -- the vectors `x - q`, `x ∈ X₀`, have nonnegative combinations equal to every vector
  have hinj : Function.Injective fun x : E => x - q := fun a b h => by simpa using h
  have hV₀ : ∀ z, ∃ l : E → ℝ, (∀ y ∈ X₀.image fun x => x - q, 0 ≤ l y) ∧
      ∑ y ∈ X₀.image (fun x => x - q), l y • y = z := by
    intro z
    obtain ⟨l, hl, hz⟩ := exists_nonneg_sum_sub_eq hX₀q z
    refine ⟨fun y => l (y + q), fun y hy => ?_, ?_⟩
    · obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
      simpa using hl x hx
    · rw [Finset.sum_image fun x _ y _ h => hinj h]
      simpa using hz
  obtain ⟨V, hVV₀, hVcard, hV⟩ := exists_subset_card_le_two_mul_nonneg_span hV₀
  have hinj' : Function.Injective fun y : E => y + q := fun a b h => by simpa using h
  have hX : ∀ z, ∃ l : E → ℝ, (∀ x ∈ V.image fun y => y + q, 0 ≤ l x) ∧
      ∑ x ∈ V.image (fun y => y + q), l x • (x - q) = z := by
    intro z
    obtain ⟨l, hl, hz⟩ := hV z
    refine ⟨fun x => l (x - q), fun x hx => ?_, ?_⟩
    · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
      simpa using hl y hy
    · rw [Finset.sum_image fun x _ y _ h => hinj' h]
      simpa using hz
  have hne : (V.image fun y => y + q).Nonempty := by
    have : Nontrivial E := Module.nontrivial_of_finrank_pos hE
    obtain ⟨z, hz⟩ := exists_ne (0 : E)
    obtain ⟨l, -, hlz⟩ := hX z
    by_contra hemp
    rw [Finset.not_nonempty_iff_eq_empty] at hemp
    rw [hemp, Finset.sum_empty] at hlz
    exact hz hlz.symm
  refine ⟨V.image fun y => y + q, fun x hx => ?_, Finset.card_image_le.trans hVcard,
    mem_interior_convexHull_of_nonneg_span hne hX⟩
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
  obtain ⟨x', hx', rfl⟩ := Finset.mem_image.mp (hVV₀ hy)
  simpa using hX₀S hx'

/-- **MLS Theorem 5.5 (Steinitz)**, printed p. 230, as printed for `S ⊂ ℝ^p` (here
`Fin p → ℝ`): if `q ∈ int(co S)` and `p ≥ 1`, some `X = {v₁, …, v_k} ⊂ S` has `q ∈ int(co X)` and
`k ≤ 2p`. Added hypothesis `p ≥ 1`. -/
theorem exists_finset_mem_interior_convexHull_card_le_two_mul_fin {p : ℕ}
    {S : Set (Fin p → ℝ)} {q : Fin p → ℝ} (hq : q ∈ interior (convexHull ℝ S)) (hp : 1 ≤ p) :
    ∃ X : Finset (Fin p → ℝ), (X : Set (Fin p → ℝ)) ⊆ S ∧ X.card ≤ 2 * p ∧
      q ∈ interior (convexHull ℝ (X : Set (Fin p → ℝ))) := by
  obtain ⟨X, h1, h2, h3⟩ := exists_finset_mem_interior_convexHull_card_le_two_mul hq
    (by rw [Module.finrank_fin_fun]; exact hp)
  rw [Module.finrank_fin_fun] at h2
  exact ⟨X, h1, h2, h3⟩

/-- **MLS printed pp. 230–231, `p = 3 (planar) ⟹ 4 ≤ k ≤ 6`**: a planar surface that is not
exceptional admits a force-closure grasp of `k` frictionless point contacts on it with
`4 ≤ k ≤ 6` (Steinitz for the upper bound, Theorem 5.4 for the lower bound, which holds for every
force-closure frictionless grasp, `four_le_of_forceClosure_planar`). Finite-force caveat:
unbounded contact forces at maintained rigid contacts (MLS p. 214). -/
theorem exists_forceClosure_card_le_six_of_not_isPlanarExceptional
    {surface : Set ((Fin 2 → ℝ) × (Fin 2 → ℝ))} (hS : ¬ IsPlanarExceptional surface) :
    ∃ (k : ℕ) (c : Fin k → (Fin 2 → ℝ) × (Fin 2 → ℝ)), 4 ≤ k ∧ k ≤ 6 ∧
      (∀ i, c i ∈ surface) ∧
      ForceClosure (planarFrictionlessMatrix c).mulVecLin (orthantCone (Fin k)) := by
  have h0 : (0 : Fin 3 → ℝ) ∈ interior (convexHull ℝ (planarContactWrenches surface)) :=
    mem_interior_iff_mem_nhds.mpr (not_not.mp hS)
  obtain ⟨X, hXS, hXc, hX0⟩ := exists_finset_mem_interior_convexHull_card_le_two_mul h0
    (by rw [Module.finrank_fin_fun]; norm_num)
  have hpre : ∀ x : X, ∃ d ∈ surface, planarWrench d.1 d.2 = x := fun x => hXS x.2
  choose d hd hdx using hpre
  set c : Fin X.card → (Fin 2 → ℝ) × (Fin 2 → ℝ) := fun i => d (X.equivFin.symm i)
  have hcol : ∀ i, (planarFrictionlessMatrix c).col i = X.equivFin.symm i := fun i => by
    rw [← hdx]
    rfl
  have hrange : Set.range (planarFrictionlessMatrix c).col = (X : Set (Fin 3 → ℝ)) := by
    ext w
    constructor
    · rintro ⟨i, rfl⟩
      rw [hcol i]
      exact (X.equivFin.symm i).2
    · intro hw
      exact ⟨X.equivFin ⟨w, hw⟩, by rw [hcol, Equiv.symm_apply_apply]⟩
  have hne : Nonempty (Fin X.card) := by
    obtain ⟨x, hx⟩ := convexHull_nonempty_iff.mp ⟨0, interior_subset hX0⟩
    exact ⟨X.equivFin ⟨x, hx⟩⟩
  have hfc : ForceClosure (planarFrictionlessMatrix c).mulVecLin (orthantCone (Fin X.card)) := by
    rw [forceClosure_mulVecLin_iff_convexHull_mem_nhds, hrange]
    exact mem_interior_iff_mem_nhds.mp hX0
  refine ⟨X.card, c, four_le_of_forceClosure_planar hfc, ?_, fun i => hd _, hfc⟩
  rw [Module.finrank_fin_fun] at hXc
  simpa using hXc

/-- **MLS printed pp. 230–231, `p = 6 (spatial) ⟹ 7 ≤ k ≤ 12`**: a spatial surface that is not
exceptional has `k` pairs, `7 ≤ k ≤ 12`, whose frictionless contact wrenches `(nᵢ; pᵢ × nᵢ)`
positively span the wrench space, so that every spatial grasp of frictionless point contacts with
frames realizing these pairs (translation `pᵢ`, third axis `nᵢ`) is force-closure (p. 224).
Finite-force caveat: unbounded contact forces at maintained rigid contacts (MLS p. 214). -/
theorem exists_positivelySpans_card_le_twelve_of_not_isSpatialExceptional
    {surface : Set (Vec3 × Vec3)} (hS : ¬ IsSpatialExceptional surface) :
    ∃ (k : ℕ) (c : Fin k → Vec3 × Vec3), 7 ≤ k ∧ k ≤ 12 ∧ (∀ i, c i ∈ surface) ∧
      PositivelySpans (fun i => Wrench.pointForce (c i).1 (c i).2) ∧
      ∀ frame : Fin k → RigidTransform,
        (∀ i, (frame i).translation = (c i).1 ∧
          (frame i).rotation.act Rotation.zAxis = (c i).2) →
        (ContactGrasp.spatial (fun _ => ContactModel.frictionless)
          frame).toGrasp.IsForceClosure := by
  have h0 : (0 : Fin 3 ⊕ Fin 3 → ℝ) ∈ interior (convexHull ℝ (spatialContactWrenches surface)) :=
    mem_interior_iff_mem_nhds.mpr (not_not.mp hS)
  obtain ⟨X, hXS, hXc, hX0⟩ := exists_finset_mem_interior_convexHull_card_le_two_mul h0
    (by rw [Module.finrank_fintype_fun_eq_card]; simp)
  have hpre : ∀ x : X, ∃ d ∈ surface, (Wrench.pointForce d.1 d.2).coordinates = x :=
    fun x => hXS x.2
  choose d hd hdx using hpre
  set c : Fin X.card → Vec3 × Vec3 := fun i => d (X.equivFin.symm i)
  have hcol : ∀ i, (Wrench.pointForce (c i).1 (c i).2).coordinates = X.equivFin.symm i :=
    fun i => hdx _
  have hrange : Set.range (fun i => (Wrench.pointForce (c i).1 (c i).2).coordinates) =
      (X : Set (Fin 3 ⊕ Fin 3 → ℝ)) := by
    ext w
    constructor
    · rintro ⟨i, rfl⟩
      beta_reduce
      rw [hcol i]
      exact (X.equivFin.symm i).2
    · intro hw
      exact ⟨X.equivFin ⟨w, hw⟩, by beta_reduce; rw [hcol, Equiv.symm_apply_apply]⟩
  have hne : Nonempty (Fin X.card) := by
    obtain ⟨x, hx⟩ := convexHull_nonempty_iff.mp ⟨0, interior_subset hX0⟩
    exact ⟨X.equivFin ⟨x, hx⟩⟩
  have hcoord : PositivelySpans fun i => (Wrench.pointForce (c i).1 (c i).2).coordinates := by
    rw [positivelySpans_iff_convexHull_mem_nhds, hrange]
    exact mem_interior_iff_mem_nhds.mp hX0
  have hpos : PositivelySpans fun i => Wrench.pointForce (c i).1 (c i).2 := by
    have hsymm : ∀ F : Wrench, Wrench.coordinatesEquiv.symm F.coordinates = F :=
      Wrench.coordinatesEquiv.symm_apply_apply
    simpa only [hsymm] using hcoord.map_linearEquiv Wrench.coordinatesEquiv.symm
  have h7 := hpos.finrank_succ_le_card (by rw [Wrench.finrank_eq_six]; norm_num)
  rw [Wrench.finrank_eq_six, Fintype.card_fin] at h7
  refine ⟨X.card, c, h7, ?_, fun i => hd _, hpos, fun frame hf => ?_⟩
  · rw [Module.finrank_fintype_fun_eq_card] at hXc
    simpa using hXc
  · rw [spatial_frictionless_isForceClosure_iff]
    have hfr : (fun i => Wrench.pointForce (frame i).translation
        ((frame i).rotation.act Rotation.zAxis)) = fun i => Wrench.pointForce (c i).1 (c i).2 :=
      funext fun i => by rw [(hf i).1, (hf i).2]
    rw [hfr]
    exact hpos

end RoboLean.Grasp
