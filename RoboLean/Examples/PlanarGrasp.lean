import RoboLean.Grasp.GraspMap
import RoboLean.Grasp.Frictionless

/-!
# MLS Examples 5.3–5.5: planar grasps

* Example 5.3 (printed p. 222, Figure 5.6): a rectangle of half-width `r` grasped by two planar
  point contacts with friction at `p_{c₁} = (-r, 0)`, `p_{c₂} = (r, 0)`, contact `y`-axes along the
  inward normals, `R_{c₁} = [[0, 1], [-1, 0]]`, `R_{c₂} = [[0, -1], [1, 0]]`. The grasp is built
  from these frames with the printed planar rule and checked against the printed matrix
  `G = [[0, 1, 0, -1], [-1, 0, 1, 0], [r, 0, r, 0]]`; the internal force `f_N = (0, 1, 0, 1)` of
  p. 223 is strictly internal; `G` is surjective for `r ≠ 0`; hence (Proposition 5.2) the grasp is
  force-closure for every `μ > 0`, `r ≠ 0`. MLS does not print this conclusion for Example 5.3
  (Figure 5.9's caption, p. 228, "Force-closure for point contact with friction", is the nearest).
* Example 5.4 (printed pp. 226–228, Figure 5.8): the frictionless grasp matrix
  `G = [[1, 0, -1, 0], [0, -1, 0, 1], [-a, b, -a, b]]`; the six printed products `v_{ij}ᵀ G`; all
  four conditions of Proposition 5.3 hold for `a, b > 0` and all four fail for `a = b = 0`, with
  the printed witness `v = (0, 0, 1)`.
* Example 5.5 (printed p. 228, Figure 5.9): the friction cones of Example 5.3 are generated by
  their edges, so force-closure of Example 5.3 is force-closure of the `3 × 4` matrix of edge
  wrenches over the orthant, which Proposition 5.3 decides. Source observation: the printed
  `G'ᵢ = [[1, 1], [μ, -μ], [μr, -μr]]` is not the edge-wrench matrix of either contact of
  Figure 5.6 under the rule of p. 222 (`rectangle_printedEdge_not_mem`).

Planar wrench coordinates are `(f_x, f_y, τ)`; coefficients are indexed from `0` (Lean `f i j`
is coefficient `j + 1` of contact `i + 1`). These are convention checks on concrete inputs and the
satisfying instances of the general theorems. Finite-force caveat: force-closure assumes
unbounded contact forces at maintained rigid contacts (MLS p. 214).
-/

noncomputable section

namespace RoboLean.Examples

open Matrix Grasp

/-! ### Example 5.3 -/

/-- The contact orientation `R_{c₁} = [[0, 1], [-1, 0]]` of MLS Example 5.3, printed p. 222, in
`SO(2)`: contact `x`-axis `(0, -1)`, contact `y`-axis (inward normal) `(1, 0)`. -/
def rectangleRotation₁ : Matrix.specialOrthogonalGroup (Fin 2) ℝ :=
  ⟨!![0, 1; -1, 0], by
    refine Matrix.mem_specialOrthogonalGroup_iff.mpr ⟨?_, ?_⟩
    · rw [Matrix.mem_orthogonalGroup_iff]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
    · simp [Matrix.det_fin_two]⟩

/-- The contact orientation `R_{c₂} = [[0, -1], [1, 0]]` of MLS Example 5.3, printed p. 222, in
`SO(2)`: contact `x`-axis `(0, 1)`, contact `y`-axis (inward normal) `(-1, 0)`. -/
def rectangleRotation₂ : Matrix.specialOrthogonalGroup (Fin 2) ℝ :=
  ⟨!![0, -1; 1, 0], by
    refine Matrix.mem_specialOrthogonalGroup_iff.mpr ⟨?_, ?_⟩
    · rw [Matrix.mem_orthogonalGroup_iff]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
    · simp [Matrix.det_fin_two]⟩

/-- The planar grasp of a rectangle, MLS Example 5.3, printed p. 222: two planar point contacts
with friction (`μ > 0`) at `p_{c₁} = (-r, 0)` and `p_{c₂} = (r, 0)` with orientations
`R_{c₁}, R_{c₂}`. -/
def rectangleGrasp (μ r : ℝ) (hμ : 0 < μ) : ContactGrasp (Fin 3 → ℝ) (Fin 2) fun _ => 2 :=
  ContactGrasp.planar (fun _ => ContactModel.planarPointContact μ hμ)
    ![rectangleRotation₁, rectangleRotation₂] ![![-r, 0], ![r, 0]]

/-- The printed grasp map of MLS Example 5.3, printed p. 222:
`G = [[0, 1, 0, -1], [-1, 0, 1, 0], [r, 0, r, 0]]`, columns `(f¹_{c₁}, f²_{c₁}, f¹_{c₂}, f²_{c₂})`. -/
def rectanglePrintedMatrix (r : ℝ) : Matrix (Fin 3) (Fin 4) ℝ :=
  !![0, 1, 0, -1; -1, 0, 1, 0; r, 0, r, 0]

/-- **MLS Example 5.3, printed p. 222**: the grasp map computed from the printed frames with the
printed planar rule `[[R, 0], [[-p_y, p_x] R, 1]]` is the printed matrix applied to the stacked
contact forces. -/
theorem rectangleGrasp_graspMap (μ r : ℝ) (hμ : 0 < μ) (f : Fin 2 → Fin 2 → ℝ) :
    (rectangleGrasp μ r hμ).graspMap f =
      rectanglePrintedMatrix r *ᵥ ![f 0 0, f 0 1, f 1 0, f 1 1] := by
  rw [ContactGrasp.graspMap_apply, Fin.sum_univ_two, rectangleGrasp,
    ContactGrasp.planar_contactMap_apply, ContactGrasp.planar_contactMap_apply,
    ContactModel.planarPointContact_wrench, ContactModel.planarPointContact_wrench,
    Planar.wrenchTransform_mulVec, Planar.wrenchTransform_mulVec]
  funext i
  fin_cases i <;>
    simp [rectanglePrintedMatrix, rectangleRotation₁, rectangleRotation₂, Matrix.mulVec,
      dotProduct, Fin.sum_univ_succ]

/-- The internal force of MLS printed p. 223 for the planar example, `f_N = (0, 1, 0, 1)`: unit
normal forces at both contacts. -/
def rectangleInternalForce : Fin 2 → Fin 2 → ℝ := ![![0, 1], ![0, 1]]

/-- MLS printed p. 223: `f_N = (0, 1, 0, 1)` gives `G f_N = 0` for the printed matrix of
Example 5.3. -/
theorem rectanglePrintedMatrix_mulVec_internal (r : ℝ) :
    rectanglePrintedMatrix r *ᵥ ![0, 1, 0, 1] = 0 := by
  funext i
  fin_cases i <;> simp [rectanglePrintedMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]

/-- The internal force `f_N = (0, 1, 0, 1)` of MLS printed p. 223 is strictly internal
(Definition 5.3) for the grasp of Example 5.3, for every `μ > 0` and every `r`. -/
theorem rectangleGrasp_isStrictlyInternalForce (μ r : ℝ) (hμ : 0 < μ) :
    IsStrictlyInternalForce (rectangleGrasp μ r hμ).graspMap
      ((rectangleGrasp μ r hμ).cone : Set (Fin 2 → Fin 2 → ℝ)) rectangleInternalForce := by
  refine ⟨?_, ?_⟩
  · rw [rectangleGrasp_graspMap]
    simpa [rectangleInternalForce] using rectanglePrintedMatrix_mulVec_internal r
  · rw [ContactGrasp.mem_interior_cone]
    intro i
    fin_cases i <;>
      exact mem_interior_planarPointContactCone (by simpa [rectangleInternalForce] using hμ)
        (by simp [rectangleInternalForce])

/-- The grasp map of MLS Example 5.3 (printed p. 222) is surjective when the contacts are apart,
`r ≠ 0`. -/
theorem rectangleGrasp_surjective (μ r : ℝ) (hμ : 0 < μ) (hr : r ≠ 0) :
    Function.Surjective (rectangleGrasp μ r hμ).graspMap := by
  intro w
  refine ⟨![![(w 2 / r - w 1) / 2, w 0], ![(w 1 + w 2 / r) / 2, 0]], ?_⟩
  rw [rectangleGrasp_graspMap]
  funext i
  fin_cases i <;>
    simp [rectanglePrintedMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_succ] <;>
    field_simp <;> ring

/-- **The planar grasp of MLS Example 5.3 (printed p. 222) is force-closure** for every
coefficient of friction `μ > 0` and every half-width `r ≠ 0`, by Proposition 5.2: the grasp map is
surjective and `f_N = (0, 1, 0, 1)` (p. 223) is strictly internal. MLS prints no conclusion for
Example 5.3; Figure 5.9 (p. 228) depicts it. Finite-force caveat: unbounded contact forces at
maintained rigid contacts (MLS p. 214). -/
theorem rectangleGrasp_isForceClosure (μ r : ℝ) (hμ : 0 < μ) (hr : r ≠ 0) :
    (rectangleGrasp μ r hμ).toGrasp.IsForceClosure :=
  (Grasp.isForceClosure_iff _).mpr
    ⟨rectangleGrasp_surjective μ r hμ hr, _, rectangleGrasp_isStrictlyInternalForce μ r hμ⟩

/-! ### Example 5.4 -/

/-- The frictionless planar grasp matrix of MLS Example 5.4, printed p. 226:
`G = [[1, 0, -1, 0], [0, -1, 0, 1], [-a, b, -a, b]]` (rows `f_x, f_y, τ`). -/
def fourContactMatrix (a b : ℝ) : Matrix (Fin 3) (Fin 4) ℝ :=
  !![1, 0, -1, 0; 0, -1, 0, 1; -a, b, -a, b]

/-- The six supporting-hyperplane candidates of MLS Example 5.4, printed p. 227, as printed:
`v₁₂ᵀG = (0, 0, -2a, 2b)`, `v₁₃ᵀG = (0, -1, 0, 1)`, `v₁₄ᵀG = (0, 2b, -2a, 0)`,
`v₂₃ᵀG = (2a, 0, 0, -2b)`, `v₂₄ᵀG = (1, 0, -1, 0)`, `v₃₄ᵀG = (2a, -2b, 0, 0)`. -/
theorem fourContactMatrix_candidates (a b : ℝ) :
    ![a, b, 1] ᵥ* fourContactMatrix a b = ![0, 0, -2 * a, 2 * b] ∧
    ![0, 1, 0] ᵥ* fourContactMatrix a b = ![0, -1, 0, 1] ∧
    ![a, -b, 1] ᵥ* fourContactMatrix a b = ![0, 2 * b, -2 * a, 0] ∧
    ![a, -b, -1] ᵥ* fourContactMatrix a b = ![2 * a, 0, 0, -2 * b] ∧
    ![1, 0, 0] ᵥ* fourContactMatrix a b = ![1, 0, -1, 0] ∧
    ![a, b, -1] ᵥ* fourContactMatrix a b = ![2 * a, -2 * b, 0, 0] := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> funext j <;> fin_cases j <;>
    simp [fourContactMatrix, Matrix.vecMul, dotProduct, Fin.sum_univ_succ] <;> ring

/-- Condition (4) of Proposition 5.3 for MLS Example 5.4 with `a, b > 0`: no `v ≠ 0` has
`v · Gᵢ ≥ 0` for all four columns (proved directly; MLS checks the six candidates of p. 227 and
leaves the sufficiency of those candidates as an exercise, p. 226). -/
theorem fourContactMatrix_no_supporting (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    ¬ ∃ v : Fin 3 → ℝ, v ≠ 0 ∧ ∀ i, 0 ≤ v ⬝ᵥ (fourContactMatrix a b).col i := by
  rintro ⟨v, hv, h⟩
  have h0 := h 0
  have h1 := h 1
  have h2 := h 2
  have h3 := h 3
  simp [fourContactMatrix, Matrix.col, dotProduct, Fin.sum_univ_succ] at h0 h1 h2 h3
  have hv2 : v 2 = 0 := by nlinarith
  have hv0 : v 0 = 0 := by rw [hv2] at h0 h2; linarith
  have hv1 : v 1 = 0 := by rw [hv2] at h1 h3; linarith
  exact hv (by funext i; fin_cases i <;> simp [hv0, hv1, hv2])

/-- **MLS Example 5.4, printed p. 227**: for `a, b > 0` all four equivalent conditions of
Proposition 5.3 hold for the frictionless grasp `G` (force-closure, positive span, a neighborhood
of `0` in the convex hull of the columns, no supporting hyperplane through `0`). Finite-force
caveat: unbounded contact forces at maintained rigid contacts (MLS p. 214). -/
theorem fourContactMatrix_forceClosure (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    ForceClosure (fourContactMatrix a b).mulVecLin (orthantCone (Fin 4)) ∧
      PositivelySpans (fourContactMatrix a b).col ∧
      convexHull ℝ (Set.range (fourContactMatrix a b).col) ∈ nhds (0 : Fin 3 → ℝ) := by
  have tfae := frictionless_tfae (fourContactMatrix a b)
  have h4 := fourContactMatrix_no_supporting a b ha hb
  have h1 : ForceClosure (fourContactMatrix a b).mulVecLin (orthantCone (Fin 4)) :=
    (tfae.out 1 4).mpr h4
  exact ⟨h1, (tfae.out 1 2).mp h1, (tfae.out 1 3).mp h1⟩

/-- **MLS Example 5.4, printed pp. 227–228**: for `a = b = 0` the grasp
`G = [[1, 0, -1, 0], [0, -1, 0, 1], [0, 0, 0, 0]]` is not force-closure; the printed witness
`v = (0, 0, 1)` has `vᵀG = 0` (condition 4 fails), the columns do not positively span `ℝ³`
(condition 2) and their convex hull is not a neighborhood of `0` (condition 3). Finite-force
caveat: unbounded contact forces at maintained rigid contacts (MLS p. 214). -/
theorem fourContactMatrix_zero_not_forceClosure :
    ![0, 0, 1] ᵥ* fourContactMatrix 0 0 = 0 ∧
      ¬ ForceClosure (fourContactMatrix 0 0).mulVecLin (orthantCone (Fin 4)) ∧
      ¬ PositivelySpans (fourContactMatrix 0 0).col ∧
      convexHull ℝ (Set.range (fourContactMatrix 0 0).col) ∉ nhds (0 : Fin 3 → ℝ) := by
  have tfae := frictionless_tfae (fourContactMatrix 0 0)
  have hwit : ∃ v : Fin 3 → ℝ, v ≠ 0 ∧ ∀ i, 0 ≤ v ⬝ᵥ (fourContactMatrix 0 0).col i := by
    refine ⟨![0, 0, 1], fun h => by simpa using congrFun h 2, fun i => ?_⟩
    fin_cases i <;> simp [fourContactMatrix, Matrix.col, dotProduct, Fin.sum_univ_succ]
  have h14 : ForceClosure (fourContactMatrix 0 0).mulVecLin (orthantCone (Fin 4)) ↔
      ¬ ∃ v : Fin 3 → ℝ, v ≠ 0 ∧ ∀ i, 0 ≤ v ⬝ᵥ (fourContactMatrix 0 0).col i := tfae.out 1 4
  have h1 : ¬ ForceClosure (fourContactMatrix 0 0).mulVecLin (orthantCone (Fin 4)) :=
    fun h => h14.mp h hwit
  refine ⟨?_, h1, fun h => h1 ((tfae.out 1 2).mpr h), fun h => h1 ((tfae.out 1 3).mpr h)⟩
  funext j
  fin_cases j <;> simp [fourContactMatrix, Matrix.vecMul, dotProduct, Fin.sum_univ_succ]

/-! ### Example 5.5 -/

/-- The edge wrenches of the friction cones of MLS Example 5.3 in object coordinates (MLS
Example 5.5, printed p. 228): columns `G₁(μ, 1)`, `G₁(-μ, 1)`, `G₂(μ, 1)`, `G₂(-μ, 1)`, computed
with the planar rule of p. 222 (`rectangleGrasp_edges`):
`[[1, 1, -1, -1], [-μ, μ, μ, -μ], [μr, -μr, μr, -μr]]`. -/
def rectangleEdgeMatrix (μ r : ℝ) : Matrix (Fin 3) (Fin 4) ℝ :=
  !![1, 1, -1, -1; -μ, μ, μ, -μ; μ * r, -(μ * r), μ * r, -(μ * r)]

/-- The four edge wrenches of the friction cones of MLS Example 5.3 (printed p. 222) in object
coordinates, as used by Example 5.5 (printed p. 228): they are the columns of
`rectangleEdgeMatrix`. -/
theorem rectangleGrasp_edges (μ r : ℝ) (hμ : 0 < μ) :
    (rectangleGrasp μ r hμ).contactMap 0 ![μ, 1] = (rectangleEdgeMatrix μ r).col 0 ∧
      (rectangleGrasp μ r hμ).contactMap 0 ![-μ, 1] = (rectangleEdgeMatrix μ r).col 1 ∧
      (rectangleGrasp μ r hμ).contactMap 1 ![μ, 1] = (rectangleEdgeMatrix μ r).col 2 ∧
      (rectangleGrasp μ r hμ).contactMap 1 ![-μ, 1] = (rectangleEdgeMatrix μ r).col 3 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    rw [rectangleGrasp, ContactGrasp.planar_contactMap_apply,
      ContactModel.planarPointContact_wrench, Planar.wrenchTransform_mulVec] <;>
    funext i <;> fin_cases i <;>
    simp [rectangleEdgeMatrix, rectangleRotation₁, rectangleRotation₂, Matrix.col] <;> ring

/-- **Source observation on MLS Example 5.5, printed p. 228** (checked against the frames of
Example 5.3, p. 222, and the rule printed there): the first column `(1, μ, μr)` of the printed
contact map `G'ᵢ = [[1, 1], [μ, -μ], [μr, -μr]]` is none of the four edge wrenches of the two
contacts, for `μ > 0` and `r > 0`; so the printed `G'ᵢ` is the edge-wrench matrix of neither
contact. (Its columns match contact 2's edge wrenches up to the sign of `f_x`, and contact 1's up
to the sign of `τ`.) -/
theorem rectangle_printedEdge_not_mem (μ r : ℝ) (hμ : 0 < μ) (hr : 0 < r) (i : Fin 4) :
    (rectangleEdgeMatrix μ r).col i ≠ ![1, μ, μ * r] := by
  intro h
  have h0 := congrFun h 0
  have h1 := congrFun h 1
  have h2 := congrFun h 2
  have hμr : 0 < μ * r := mul_pos hμ hr
  fin_cases i <;> simp [rectangleEdgeMatrix, Matrix.col] at h0 h1 h2 <;> linarith

/-- The generator map of MLS Example 5.5, printed p. 228: nonnegative edge coefficients
`(s₁, t₁, s₂, t₂)` to the contact forces `(s₁(μ, 1) + t₁(-μ, 1), s₂(μ, 1) + t₂(-μ, 1))` of the two
planar contacts of Example 5.3. -/
def rectangleEdgeGenerators (μ : ℝ) : (Fin 4 → ℝ) →ₗ[ℝ] (Fin 2 → Fin 2 → ℝ) where
  toFun s := ![s 0 • ![μ, 1] + s 1 • ![-μ, 1], s 2 • ![μ, 1] + s 3 • ![-μ, 1]]
  map_add' s t := by
    funext i j
    fin_cases i <;> fin_cases j <;> simp <;> ring
  map_smul' c s := by
    funext i j
    fin_cases i <;> fin_cases j <;> simp <;> ring

/-- MLS Example 5.5, printed p. 228: the friction cone of Example 5.3 is the image of the orthant
under the edge generators (for `μ > 0`). -/
theorem rectangleGrasp_cone_eq_image (μ r : ℝ) (hμ : 0 < μ) :
    ((rectangleGrasp μ r hμ).cone : Set (Fin 2 → Fin 2 → ℝ)) =
      rectangleEdgeGenerators μ '' (orthantCone (Fin 4) : Set (Fin 4 → ℝ)) := by
  ext f
  constructor
  · intro hf
    have hf0 := (ContactGrasp.mem_cone _).mp hf 0
    have hf1 := (ContactGrasp.mem_cone _).mp hf 1
    obtain ⟨s₁, t₁, hs₁, ht₁, h₁⟩ := (mem_planarPointContactCone_iff_edges hμ).mp hf0
    obtain ⟨s₂, t₂, hs₂, ht₂, h₂⟩ := (mem_planarPointContactCone_iff_edges hμ).mp hf1
    refine ⟨![s₁, t₁, s₂, t₂], fun i => ?_, ?_⟩
    · fin_cases i <;> simpa
    · funext i
      fin_cases i
      · simpa [rectangleEdgeGenerators] using h₁.symm
      · simpa [rectangleEdgeGenerators] using h₂.symm
  · rintro ⟨s, hs, rfl⟩
    refine (ContactGrasp.mem_cone _).mpr fun i => ?_
    have hs' : ∀ i, 0 ≤ s i := hs
    fin_cases i
    · exact (mem_planarPointContactCone_iff_edges hμ).mpr ⟨s 0, s 1, hs' 0, hs' 1, rfl⟩
    · exact (mem_planarPointContactCone_iff_edges hμ).mpr ⟨s 2, s 3, hs' 2, hs' 3, rfl⟩

/-- **MLS Example 5.5, printed p. 228**: force-closure of the friction grasp of Example 5.3 is
force-closure of the edge-wrench matrix over the orthant, "the same form as two independent,
frictionless point contacts" per contact, decided by Proposition 5.3. Finite-force caveat:
unbounded contact forces at maintained rigid contacts (MLS p. 214). -/
theorem rectangleGrasp_isForceClosure_iff_edges (μ r : ℝ) (hμ : 0 < μ) :
    (rectangleGrasp μ r hμ).toGrasp.IsForceClosure ↔
      ForceClosure (rectangleEdgeMatrix μ r).mulVecLin (orthantCone (Fin 4)) := by
  have hcomp : (rectangleGrasp μ r hμ).graspMap ∘ₗ rectangleEdgeGenerators μ =
      (rectangleEdgeMatrix μ r).mulVecLin := by
    apply LinearMap.ext
    intro s
    rw [LinearMap.comp_apply, rectangleGrasp_graspMap, Matrix.mulVecLin_apply]
    funext i
    fin_cases i <;>
      simp [rectangleEdgeGenerators, rectanglePrintedMatrix, rectangleEdgeMatrix,
        Matrix.mulVec, dotProduct, Fin.sum_univ_succ] <;> ring
  change ForceClosure (rectangleGrasp μ r hμ).graspMap
      ((rectangleGrasp μ r hμ).cone : Set (Fin 2 → Fin 2 → ℝ)) ↔ _
  rw [rectangleGrasp_cone_eq_image, forceClosure_image_iff, hcomp]

/-- **MLS Example 5.5 with Proposition 5.3, printed p. 228**: the edge wrenches of Example 5.3
positively span `ℝ³` for `μ > 0`, `r ≠ 0` (sums of pairs give `±(2, 0, 0)`, `±(0, 2μ, 0)`,
`±(0, 0, 2μr)`), so the friction grasp of Example 5.3 is force-closure by this second route.
Finite-force caveat: unbounded contact forces at maintained rigid contacts (MLS p. 214). -/
theorem rectangleEdgeMatrix_forceClosure (μ r : ℝ) (hμ : 0 < μ) (hr : r ≠ 0) :
    ForceClosure (rectangleEdgeMatrix μ r).mulVecLin (orthantCone (Fin 4)) := by
  rw [forceClosure_mulVecLin_iff_not_exists_dotProduct_nonneg]
  rintro ⟨v, hv, h⟩
  have h0 := h 0
  have h1 := h 1
  have h2 := h 2
  have h3 := h 3
  simp [rectangleEdgeMatrix, Matrix.col, dotProduct, Fin.sum_univ_succ] at h0 h1 h2 h3
  have hμr : μ * r ≠ 0 := mul_ne_zero hμ.ne' hr
  -- the four inequalities pair up into equalities
  have e0 : v 0 = 0 := by nlinarith
  have e1 : μ * v 1 = 0 := by nlinarith
  have e2 : μ * r * v 2 = 0 := by nlinarith
  have hv1 : v 1 = 0 := (mul_eq_zero.mp e1).resolve_left hμ.ne'
  have hv2 : v 2 = 0 := (mul_eq_zero.mp e2).resolve_left hμr
  exact hv (by funext i; fin_cases i <;> simp [e0, hv1, hv2])

end RoboLean.Examples
