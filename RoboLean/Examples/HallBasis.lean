import RoboLean.Nonholonomic.HallBasis

/-!
# The basis claim of p. 345 read literally for vector fields

MLS p. 345: "a Philip Hall basis is indeed a basis for the Lie algebra generated by
`{g₁, …, g_m}`". For vector fields this fails: the constant fields `g₁ = e₁`, `g₂ = e₂` on `ℝ²`
are smooth and linearly independent at every point (the hypotheses of (7.10), p. 329), the three
products `g₁`, `g₂`, `[g₁, g₂]` are Philip Hall products, and `[g₁, g₂] = 0`, so their fields are
not linearly independent. The basis property belongs to the free Lie algebra
(`HallBasisStatement`); in `L(g₁, …, g_m)` the Hall products only span.
-/

noncomputable section

open scoped ContDiff
open RoboLean.Nonholonomic RoboLean.Nonholonomic.LieProduct

namespace RoboLean
namespace Examples

/-- **For MLS p. 345:** the constant fields `g₁ = e₁`, `g₂ = e₂` on `ℝ²`. -/
def hallCounterFields : Fin 2 → (Fin 2 → ℝ) → Fin 2 → ℝ := fun j _ => Pi.single j 1

/-- **For MLS p. 345:** the products `g₁`, `g₂`, `[g₁, g₂]`. -/
def hallCounterProducts : Fin 3 → LieProduct 2 := ![gen 0, gen 1, br (gen 0) (gen 1)]

/-- **MLS p. 345, the basis claim read for vector fields, refuted:** the fields `e₁`, `e₂` on `ℝ²`
are smooth and linearly independent at every point, `g₁`, `g₂`, `[g₁, g₂]` are Philip Hall
products, and their fields are not linearly independent (`[g₁, g₂] = 0`). -/
theorem hallCounter_not_linearIndependent :
    (∀ j, ContDiff ℝ ∞ (hallCounterFields j)) ∧
      (∀ q, LinearIndependent ℝ fun j => hallCounterFields j q) ∧
      (∀ i, IsHall (hallCounterProducts i) = true) ∧
      eval hallCounterFields (br (gen 0) (gen 1)) = 0 ∧
      ¬ LinearIndependent ℝ fun i => eval hallCounterFields (hallCounterProducts i) := by
  have hbr : eval hallCounterFields (br (gen 0) (gen 1)) = 0 := by
    funext x
    have h0 : ∀ j, fderiv ℝ (hallCounterFields j) x = 0 := fun j =>
      fderiv_const_apply (Pi.single j 1 : Fin 2 → ℝ)
    simp [eval, VectorField.lieBracket_eq, h0]
  refine ⟨fun j => contDiff_const, fun q => ?_, fun i => by fin_cases i <;> decide, hbr, ?_⟩
  · have := (Pi.basisFun ℝ (Fin 2)).linearIndependent
    convert this using 1
    funext j
    simp [hallCounterFields]
  · intro h
    apply h.ne_zero 2
    simpa [hallCounterProducts] using hbr

end Examples
end RoboLean
